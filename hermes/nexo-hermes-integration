#!/usr/bin/env python3
"""
nexo-hermes-integration — Demostración de integración Nexo-Hermes
"""
import os
import sys
import subprocess
import sqlite3
from pathlib import Path

def run_cmd(cmd):
    try:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        return result.stdout.strip()
    except:
        return "N/A"

def main():
    print("🔗 Nexo-Hermes Integration Demo")
    print("=" * 40)
    
    # Verificar Hermes
    hermes_cmd = "hermes" if run_cmd("which hermes") else str(Path.home() / ".hermes/hermes-agent/venv/bin/hermes")
    
    print("\n1. Verificando instalación de Hermes...")
    result = subprocess.run([hermes_cmd, "--version"], capture_output=True)
    if result.returncode != 0:
        print("⚠️  Hermes no está configurado correctamente")
    
    print("\n2. Configuración actual de Hermes:")
    print("   - Directorio: ~/.hermes/")
    print("   - Config: ~/.hermes/config.yaml")
    print("   - Memoria: ~/.hermes/memories/")
    print("   - Skills: ~/.hermes/hermes-agent/skills/")
    
    print("\n3. Scripts de integración creados:")
    print("   - nexo-memory-enhance: Mejora sistema de memoria")
    print("   - nexo-skill-creator: Crea habilidades automáticamente")
    
    print("\n4. Ejemplo de uso de Hermes:")
    print("   hermes                    # Chat interactivo")
    print("   hermes model              # Configurar modelo")
    print("   hermes skills list        # Ver skills disponibles")
    print("   hermes -z 'Analiza...'    # Ejecutar tarea")
    
    # Verificar base de datos
    print("\n5. Demostración de memoria mejorada:")
    db_path = Path.home() / ".nexo-memory" / "graph.db"
    
    if db_path.exists():
        conn = sqlite3.connect(str(db_path))
        cursor = conn.cursor()
        
        cursor.execute("SELECT name FROM sqlite_master WHERE type='table'")
        tables = [row[0] for row in cursor.fetchall()]
        
        print("   Tablas en base de datos:")
        for table in tables:
            if "conversation" in table or "learned" in table or "auto_skills" in table:
                print(f"   ✅ {table}")
        
        conn.close()
    else:
        print("   ⚠️  Base de datos no encontrada")
    
    print("\n6. Próximos pasos:")
    print("   a) Configurar API key en ~/.hermes/.env")
    print("   b) Ejecutar: hermes setup")
    print("   c) Probar: hermes -z 'Hola, soy Nexo'")
    
    print("\n✅ Integración Nexo-Hermes completada")

if __name__ == "__main__":
    main()
