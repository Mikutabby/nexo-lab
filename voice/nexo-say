#!/usr/bin/env python3
"""
nexo-say — Wrapper TTS que detecta si nexo-face está corriendo
"""
import os
import sys
import subprocess

STATE_FILE = "/tmp/nexo-face-state.json"

def main():
    # Verificar si nexo-face está corriendo
    face_running = False
    try:
        result = subprocess.run(["pgrep", "-f", "python3 -m http.server 7072"],
                              capture_output=True)
        face_running = result.returncode == 0
    except Exception:
        pass
    
    if face_running:
        # Usar nexo-face-say
        face_say = os.path.expanduser("~/.local/bin/nexo-face-say")
        if os.path.exists(face_say):
            os.execvp("bash", ["bash", face_say] + sys.argv[1:])
    
    # TTS normal
    say_script = os.path.expanduser("~/nexo-lab/nexo-lab/voice/say.sh")
    if os.path.exists(say_script):
        os.execvp("bash", ["bash", say_script] + sys.argv[1:])
    else:
        print("Error: say.sh no encontrado", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
