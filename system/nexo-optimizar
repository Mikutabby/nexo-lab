#!/usr/bin/env python3
"""
nexo-optimizer — Optimizaciones de rendimiento para PC vieja
"""
import os
import sys
import subprocess
import shutil
from pathlib import Path
from datetime import datetime

BACKUP_DIR = Path.home() / "nexo-optimizer-backups"

def log(msg): print(f"\033[1;32m[+]\033[0m {msg}")
def warn(msg): print(f"\033[1;33m[!]\033[0m {msg}")
def err(msg): print(f"\033[1;31m[x]\033[0m {msg}", file=sys.stderr)

def run(cmd, check=False):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True,
                         stdin=subprocess.DEVNULL)

def backup():
    date = datetime.now().strftime("%Y%m%d_%H%M%S")
    backup_path = BACKUP_DIR / date
    backup_path.mkdir(parents=True, exist_ok=True)
    
    files_to_backup = [
        "/etc/fstab",
        "/etc/sysctl.d",
        "/etc/udev/rules.d",
        "/etc/systemd/system",
    ]
    
    for src in files_to_backup:
        if os.path.exists(src):
            dst = backup_path / Path(src).name
            if os.path.isdir(src):
                shutil.copytree(src, dst)
            else:
                shutil.copy2(src, dst)
    
    log(f"Backup creado en {backup_path}")

def restore():
    if not BACKUP_DIR.exists():
        err("No hay backups")
        return 1
    
    backups = sorted(BACKUP_DIR.iterdir(), reverse=True)
    if not backups:
        err("No hay backups")
        return 1
    
    latest = backups[0]
    warn(f"Restaurando backup: {latest.name}")
    
    # Restaurar archivos
    fstab = latest / "fstab"
    if fstab.exists():
        run(f"cp {fstab} /etc/fstab")
    
    for subdir in ["sysctl", "udev", "systemd"]:
        src = latest / subdir
        if src.exists():
            dst = Path(f"/etc/{subdir}/.system") if subdir == "systemd" else Path(f"/etc/{subdir}")
            shutil.copytree(src, dst, dirs_exist_ok=True)
    
    log("Restaurado. Requiere reinicio.")
    return 0

def optimize_all():
    log("=== 1. Governor schedutil ===")
    run("echo schedutil > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor")
    
    # Servicio systemd
    service = """[Unit]
Description=Nexo CPU Governor - schedutil
DefaultDependencies=no
After=sysinit.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo schedutil > "$cpu"; done'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target"""
    
    service_path = Path("/etc/systemd/system/nexo-governor.service")
    service_path.write_text(service)
    run("systemctl enable nexo-governor.service")
    log("   Governor schedutil OK")
    
    log("=== 2. BFQ I/O scheduler ===")
    run("echo bfq > /sys/block/sda/queue/scheduler")
    
    udev_rules = """ACTION=="add|change", KERNEL=="sd*[!0-9]", ATTR{queue/scheduler}="bfq"
ACTION=="add|change", KERNEL=="sd*[!0-9]", ATTR{queue/read_ahead_kb}="16384"
ACTION=="add|change", KERNEL=="sd*[!0-9]", ATTR{queue/nr_requests}="128" """
    
    Path("/etc/udev/rules.d/99-nexo-io-scheduler.rules").write_text(udev_rules)
    log("   BFQ + read_ahead=16384 + nr_requests=128 OK")
    
    log("=== 3. Zstd en zram ===")
    run("swapoff /dev/zram0")
    run("echo 1 > /sys/block/zram0/reset")
    run("echo zstd > /sys/block/zram0/comp_algorithm")
    run("echo 1941500K > /sys/block/zram0/disksize")
    run("mkswap /dev/zram0")
    run("swapon -p 100 /dev/zram0")
    log("   Zstd en zram OK")
    
    log("=== 4. Sysctl potencia ===")
    sysctl_conf = """vm.dirty_writeback_centisecs = 200
vm.dirty_expire_centisecs = 1500
vm.vfs_cache_pressure = 50
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
vm.swappiness = 10
net.core.rmem_max = 131072
net.core.wmem_max = 131072"""
    
    Path("/etc/sysctl.d/91-nexo-potencia.conf").write_text(sysctl_conf)
    run("sysctl -p /etc/sysctl.d/91-nexo-potencia.conf")
    log("   Sysctl potencia OK")
    
    log("=== 5. THP a madvise ===")
    run("echo madvise > /sys/kernel/mm/transparent_hugepage/enabled")
    
    thp_service = """[Unit]
Description=Set THP to madvise
DefaultDependencies=no
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo madvise > /sys/kernel/mm/transparent_hugepage/enabled'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target"""
    
    Path("/etc/systemd/system/nexo-thp.service").write_text(thp_service)
    run("systemctl enable nexo-thp.service")
    log("   THP madvise OK")
    
    log("=== 6. noatime en fstab ===")
    fstab = Path("/etc/fstab")
    if fstab.exists():
        content = fstab.read_text()
        content = content.replace("rw,relatime", "rw,noatime")
        fstab.write_text(content)
    log("   noatime OK")
    
    log("=== 7. tmpfs para /tmp ===")
    run("grep -q 'tmpfs /tmp' /etc/fstab || echo 'tmpfs /tmp tmpfs rw,nosuid,nodev,size=512M 0 0' >> /etc/fstab")
    run("mount -t tmpfs tmpfs /tmp -o rw,nosuid,nodev,size=512M")
    log("   tmpfs /tmp OK")
    
    log("=== 8. Bluetooth off ===")
    run("rfkill block bluetooth")
    run("modprobe -r btusb")
    Path("/etc/modprobe.d/nexo-nobt.conf").write_text("blacklist bluetooth")
    log("   Bluetooth desactivado OK")
    
    log("=== 9. Desactivar accounts-daemon ===")
    run("systemctl disable --now accounts-daemon.service")
    log("   accounts-daemon desactivado OK")
    
    log("")
    log("=" * 60)
    log("🚀 OPTIMIZACIONES APLICADAS EXITOSAMENTE")
    log("=" * 60)
    warn("  noatime + tmpfs /tmp: requieren REINICIO")

def show_status():
    log("=== ESTADO DE OPTIMIZACIONES ===")
    
    def read_sys(path):
        try:
            return Path(path).read_text().strip()
        except:
            return "N/A"
    
    def get_value(cmd):
        result = run(cmd)
        return result.stdout.strip() if result.returncode == 0 else "N/A"
    
    print(f"Governor:         {read_sys('/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor')}")
    print(f"CPU freq:         {read_sys('/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq')} KHz")
    print(f"I/O scheduler:    {get_value('cat /sys/block/sda/queue/scheduler | grep -o \"\\[.*\\]\"')}")
    print(f"Zram algo:        {get_value('cat /sys/block/zram0/comp_algorithm | grep -o \"\\[.*\\]\"')}")
    print(f"THP:              {get_value('cat /sys/kernel/mm/transparent_hugepage/enabled | grep -oP \"\\[\\K[^\\]]+\"')}")
    print(f"noatime:          {'✅' if 'noatime' in get_value('grep noatime /etc/fstab') else '❌'}")
    print(f"dirty_writeback:  {read_sys('/proc/sys/vm/dirty_writeback_centisecs')} cs")
    print(f"swappiness:       {read_sys('/proc/sys/vm/swappiness')}")

def show_help():
    print("""🚀 Nexo PC Optimizer v2.0
Optimizaciones para PC vieja: Celeron 847, 4GB RAM, HDD

Uso:
  nexo-optimizer [all|status|restore]

  all      Aplicar todas las optimizaciones
  status   Mostrar estado actual
  restore  Restaurar último backup""")

def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "all"
    
    if cmd in ["--help", "-h"]:
        show_help()
        return 0
    elif cmd == "status":
        show_status()
        return 0
    elif cmd == "restore":
        return restore()
    elif cmd == "all":
        backup()
        optimize_all()
        return 0
    else:
        print(f"Comando desconocido: {cmd}")
        show_help()
        return 1

if __name__ == "__main__":
    sys.exit(main())
