#!/usr/bin/env python3
"""
nexo-terminal — Terminal personalizada de Nexo
"""
import os
import sys
import subprocess
from pathlib import Path

CONFIG = Path.home() / ".nexo-terminalrc"
TITLE = "NEXO TERMINAL"

def main():
    if not CONFIG.exists():
        print(f"Error: No se encontró {CONFIG}", file=sys.stderr)
        return 1
    
    # Detectar terminal disponible
    terminals = [
        (["xfce4-terminal", "--hold", "--title=" + TITLE, "--geometry=100x30", 
          "-e", f"bash --rcfile {CONFIG}"], "xfce4-terminal"),
        (["gnome-terminal", "--title=" + TITLE, "--", "bash", "--rcfile", str(CONFIG)], "gnome-terminal"),
        (["konsole", "--title", TITLE, "-e", "bash", "--rcfile", str(CONFIG)], "konsole"),
    ]
    
    for cmd, name in terminals:
        if subprocess.run(["which", name], capture_output=True).returncode == 0:
            subprocess.Popen(cmd)
            print("Nexo Terminal abierta")
            return 0
    
    # Fallback: bash con config
    os.execvp("bash", ["bash", "--rcfile", str(CONFIG)])
    return 0

if __name__ == "__main__":
    sys.exit(main())
