#!/bin/bash
# nexo-terminal - Terminal personalizada de Nexo
# Abre una terminal con prompt personalizado, colores y aliases

CONFIG="$HOME/.nexo-terminalrc"
TITLE="NEXO TERMINAL"

# Verificar que existe la config
if [ ! -f "$CONFIG" ]; then
    echo "Error: No se encontro $CONFIG"
    exit 1
fi

# Matar instancias anteriores de nexo-terminal (no las normales)
# pkill -f "NEXO TERMINAL" 2>/dev/null

# Detectar terminal disponible
launch_term() {
    if command -v xfce4-terminal &>/dev/null; then
        xfce4-terminal --hold \
            --title="$TITLE" \
            --geometry=100x30 \
            -e "bash --rcfile $CONFIG" &
    elif command -v gnome-terminal &>/dev/null; then
        gnome-terminal --title="$TITLE" \
            -- bash --rcfile "$CONFIG" &
    elif command -v konsole &>/dev/null; then
        konsole --title "$TITLE" -e bash --rcfile "$CONFIG" &
    else
        # Fallback: bash con config
        bash --rcfile "$CONFIG"
    fi
}

launch_term
echo "Nexo Terminal abierta"
