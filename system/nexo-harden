#!/usr/bin/env python3
"""
nexo-harden — Hardening de seguridad para Linux
"""
import os
import sys
import subprocess
import shutil
from pathlib import Path

class Colors:
    RED = '\033[0;31m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    BLUE = '\033[0;34m'
    NC = '\033[0m'

def info(msg): print(f"{Colors.BLUE}[INFO]{Colors.NC} {msg}")
def ok(msg): print(f"{Colors.GREEN}[OK]{Colors.NC} {msg}")
def warn(msg): print(f"{Colors.YELLOW}[WARN]{Colors.NC} {msg}")
def err(msg): print(f"{Colors.RED}[ERR]{Colors.NC} {msg}", file=sys.stderr)

def run_cmd(cmd, capture=True):
    return subprocess.run(cmd, capture_output=capture, text=True)

def show_status():
    print("🛡️  Nexo Security Status")
    print("=" * 40)
    
    # Kernel
    print("\n--- Kernel ---")
    kernel_params = {
        "net.ipv4.tcp_syncookies": "1",
        "net.ipv4.conf.all.accept_source_route": "0",
        "net.ipv4.conf.all.accept_redirects": "0",
        "net.ipv4.icmp_echo_ignore_all": "1",
        "kernel.dmesg_restrict": "1",
        "kernel.kptr_restrict": "2",
    }
    
    for key, expected in kernel_params.items():
        result = run_cmd(["sysctl", "-n", key])
        current = result.stdout.strip() if result.returncode == 0 else "no disponible"
        if current == expected:
            ok(f"{key} = {current}")
        else:
            warn(f"{key} = {current} (esperado: {expected})")
    
    # SSH
    print("\n--- SSH ---")
    ssh_config = Path("/etc/ssh/sshd_config")
    if ssh_config.exists():
        content = ssh_config.read_text()
        if "PermitRootLogin no" in content:
            ok("Root login: deshabilitado")
        else:
            warn("Root login: HABILITADO ⚠️")
    
    # Firewall
    print("\n--- Firewall ---")
    if shutil.which("ufw"):
        run_cmd(["ufw", "status"])
    elif shutil.which("iptables"):
        run_cmd(["iptables", "-L", "INPUT", "-n"])
    else:
        warn("No se detectó firewall")
    
    # Sudoers
    print("\n--- Sudoers ---")
    sudoers = Path("/etc/sudoers.d/temp-monitor")
    if sudoers.exists():
        ok("Sudoers Nexo instalado")
    else:
        warn("Sudoers Nexo NO instalado")

def apply_hardening(dry_run=False):
    print("=" * 50)
    print("  🛡️  Nexo Security Hardener")
    print("=" * 50)
    
    if dry_run:
        print("  Modo: --check (solo simulación)")
    print()
    
    if not dry_run and os.geteuid() != 0:
        err("Ejecutá con sudo: sudo nexo-harden --apply")
        return 1
    
    # 1. Kernel sysctl
    info("Aplicando kernel hardening...")
    sysctl_conf = Path("/etc/sysctl.d/99-nexo-hardening.conf")
    sysctl_rules = """# Nexo Security Hardening
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.icmp_echo_ignore_all = 1
kernel.dmesg_restrict = 1
kernel.kptr_restrict = 2
"""
    
    if dry_run:
        info(f"Se crearía: {sysctl_conf}")
    else:
        sysctl_conf.write_text(sysctl_rules)
        run_cmd(["sysctl", "-p", str(sysctl_conf)])
        ok("Kernel hardening aplicado")
    
    # 2. Firewall
    info("Configurando firewall...")
    if shutil.which("ufw"):
        if dry_run:
            info("Se configuraría UFW")
        else:
            run_cmd(["ufw", "default", "deny", "incoming"])
            run_cmd(["ufw", "default", "allow", "outgoing"])
            run_cmd(["ufw", "allow", "ssh"])
            run_cmd(["ufw", "--force", "enable"])
            ok("Firewall UFW configurado")
    
    # 3. SSH
    ssh_config = Path("/etc/ssh/sshd_config")
    if ssh_config.exists():
        info("Aplicando hardening SSH...")
        if dry_run:
            info("Se modificaría sshd_config")
        else:
            backup = ssh_config.with_suffix(".nexo-backup")
            shutil.copy2(ssh_config, backup)
            
            content = ssh_config.read_text()
            settings = [
                "PermitRootLogin no",
                "PasswordAuthentication no",
                "MaxAuthTries 3",
                "ClientAliveInterval 300",
            ]
            
            for setting in settings:
                key = setting.split()[0]
                if key not in content:
                    content += f"\n{setting}"
            
            ssh_config.write_text(content)
            run_cmd(["systemctl", "restart", "sshd"])
            ok("SSH hardening aplicado")
    
    # 4. Permisos
    info("Verificando permisos...")
    bin_dir = Path.home() / ".local" / "bin"
    if bin_dir.exists() and not dry_run:
        for f in bin_dir.iterdir():
            if f.is_file():
                f.chmod(0o755)
        
        for敏感file in [
            Path.home() / ".nexo-memory" / "graph.db",
            Path.home() / ".face_embeddings.pkl",
        ]:
            if 敏感file.exists():
                敏感file.chmod(0o600)
        
        ok("Permisos ajustados")
    
    print()
    print("=" * 50)
    if dry_run:
        print("  ✅ Simulación completada")
        print("  Ejecutá: sudo nexo-harden --apply")
    else:
        print("  ✅ Hardening aplicado")
    print("=" * 50)
    
    return 0

def show_help():
    print("""🛡️  Nexo Security Hardener
Aplica configuraciones de seguridad para Linux.

Uso:
  sudo nexo-harden [--check|--apply|--status]

Modos:
  --check   Solo mostrar qué cambios se harían (dry-run)
  --apply   Aplicar hardening (por defecto)
  --status  Mostrar estado actual""")

def main():
    args = sys.argv[1:]
    mode = args[0] if args else "--apply"
    
    if mode in ["--help", "-h"]:
        show_help()
        return 0
    elif mode == "--status":
        show_status()
        return 0
    elif mode == "--check":
        return apply_hardening(dry_run=True)
    else:
        return apply_hardening(dry_run=False)

if __name__ == "__main__":
    sys.exit(main())
