def main():
    import sys
    
    if len(sys.argv) < 2:
        print("📚 Nexo Knowledge — Sistema de conocimiento completo")
        print("\nComandos:")
        print("  populate  → Poblar grafo con todo el conocimiento")
        print("  system    → Solo conocimiento del sistema")
        print("  miku      → Solo conocimiento de miku")
        print("  nexo      → Solo conocimiento de Nexo")
        return
    
    cmd = sys.argv[1]
    
    if cmd == "populate":
        populate_system_knowledge()
        populate_relationships()
        populate_miku_knowledge()
        populate_nexo_knowledge()
        print("\n✅ Conocimiento completo poblado")
    
    elif cmd == "system":
        populate_system_knowledge()
    
    elif cmd == "miku":
        populate_miku_knowledge()
    
    elif cmd == "nexo":
        populate_nexo_knowledge()
    
    else:
        print(f"❌ Comando desconocido: {cmd}")

if __name__ == "__main__":
    main()
