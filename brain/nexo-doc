#!/usr/bin/env python3
"""Nexo Auto-Doc - Documentacion automatica despues de tareas."""

import json
import sys
from pathlib import Path
from datetime import datetime, timezone

GRAPH_PATH = Path.home() / ".nexo-memory" / "graph-v2.db"

def log_task(task_name, what_did, why, result, improvement=""):
    """Log a completed task with documentation."""
    import subprocess
    
    # Add to knowledge graph
    cmd = [
        "nexo-graph", "add", "fact",
        f"Tarea completada: {task_name}",
        f"Que hice: {what_did}\nPor que: {why}\nResultado: {result}\nMejora: {improvement}"
    ]
    subprocess.run(cmd, capture_output=True)
    
    # Add relation
    cmd = ["nexo-graph", "link", f"Tarea: {task_name}", "completed_by", "Nexo"]
    subprocess.run(cmd, capture_output=True)
    
    print(f"Tarea documentada: {task_name}")

def main():
    if len(sys.argv) < 4:
        print("Nexo Auto-Doc - Documentacion automatica")
        print("\nUso:")
        print("  nexo-doc <nombre_tarea> <que_hiciste> <por_que> <resultado> [mejora]")
        return
    
    task_name = sys.argv[1]
    what_did = sys.argv[2]
    why = sys.argv[3]
    result = sys.argv[4] if len(sys.argv) > 4 else ""
    improvement = sys.argv[5] if len(sys.argv) > 5 else ""
    
    log_task(task_name, what_did, why, result, improvement)

if __name__ == "__main__":
    main()
