#!/usr/bin/env python3
"""
nexo-memory-improve — Mejora de memoria de Nexo
"""
import os
import sys
import subprocess
from pathlib import Path

def run_cmd(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True)
    except Exception:
        return subprocess.CompletedProcess(cmd, 1, "", "")

def main():
    db_path = Path.home() / ".nexo-memory" / "graph.db"
    
    if not db_path.exists():
        print("❌ No se encontró la base de datos de Nexo", file=sys.stderr)
        return 1
    
    print("🧠 Nexo Memory Enhancement")
    print("=" * 30)
    print()
    print("📋 Mejoras disponibles:")
    print("  1. Organización inteligente de hechos")
    print("  2. Búsqueda semántica mejorada")
    print("  3. Ambas (recomendado)")
    print()
    
    option = input("Selecciona una opción (1-3): ").strip()
    
    if option == "1":
        print()
        print("🔄 Ejecutando organización inteligente...")
        subprocess.run([str(Path.home() / ".local/bin/nexo-memory-organize")])
    elif option == "2":
        print()
        print("🔍 Ejecutando búsqueda semántica mejorada...")
        subprocess.run([str(Path.home() / ".local/bin/nexo-semantic-enhance")])
    elif option == "3":
        print()
        print("🔄 Ejecutando organización inteligente...")
        subprocess.run([str(Path.home() / ".local/bin/nexo-memory-organize")])
        print()
        print("🔍 Ejecutando búsqueda semántica mejorada...")
        subprocess.run([str(Path.home() / ".local/bin/nexo-semantic-enhance")])
    else:
        print("❌ Opción no válida")
        return 1
    
    print()
    print("✅ Mejora de memoria completada")
    print()
    print("📊 Resumen de mejoras:")
    print("  • Organización: Hechos categorizados automáticamente")
    print("  • Búsqueda semántica: Embeddings generados para todos los nodos")
    print()
    print("🔧 Para usar la búsqueda semántica:")
    print("  nexo-graph semsearch 'tu consulta'")
    
    return 0

if __name__ == "__main__":
    sys.exit(main())
