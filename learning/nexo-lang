#!/usr/bin/env python3
"""
nexo-lang — Analizador de Lenguaje de Nexo
"""
import os
import sys
import json
import re
from pathlib import Path
from datetime import datetime
from collections import Counter

MEMORY_DIR = Path.home() / ".nexo-memory"
LANGUAGE_DIR = MEMORY_DIR / "learned" / "language"
MESSAGES_FILE = LANGUAGE_DIR / "messages.jsonl"

LANGUAGE_DIR.mkdir(parents=True, exist_ok=True)

# Typos comunes en español
TYPOS = {
    r'\bola\b': 'hola',
    r'\bquiro\b': 'quiero',
    r'\bquero\b': 'quiero',
    r'\bcmo\b': 'como',
    r'\bkmo\b': 'como',
    r'\btemperatua\b': 'temperatura',
    r'\bmonito\b': 'monitor',
    r'\barchvo\b': 'archivo',
    r'\barchiivo\b': 'archivo',
    r'\bfuncna\b': 'funciona',
    r'\bfuncioan\b': 'funciona',
    r'\berorr\b': 'error',
    r'\beror\b': 'error',
    r'\bayda\b': 'ayuda',
    r'\bnecsito\b': 'necesito',
    r'\bprobelma\b': 'problema',
    r'\bprobleam\b': 'problema',
    r'\bsolucion\b': 'solución',
    r'\binstlar\b': 'instalar',
    r'\bconfigrar\b': 'configurar',
    r'\bejcutar\b': 'ejecutar',
    r'\bverifcar\b': 'verificar',
    r'\breinicar\b': 'reiniciar',
    r'\bactuallizar\b': 'actualizar',
    r'\bnexus\b': 'nexo',
    r'\bnexu\b': 'nexo',
    r'\bnexa\b': 'nexo',
    r'\bbasj\b': 'bash',
    r'\bscrip\b': 'script',
    r'\btermianl\b': 'terminal',
    r'\btermnal\b': 'terminal',
    r'\bcomadno\b': 'comando',
    r'\bpyhton\b': 'python',
    r'\bpytohn\b': 'python',
}

class Colors:
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    CYAN = '\033[0;36m'
    NC = '\033[0m'

def load_jsonl(filepath):
    entries = []
    if filepath.exists():
        with open(filepath) as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        entries.append(json.loads(line))
                    except json.JSONDecodeError:
                        continue
    return entries

def save_jsonl(filepath, entries):
    with open(filepath, "w") as f:
        for entry in entries:
            f.write(json.dumps(entry) + "\n")

def auto_correct(text):
    corrected = text
    for pattern, replacement in TYPOS.items():
        corrected = re.sub(pattern, replacement, corrected, flags=re.IGNORECASE)
    
    # Corregir repeticiones excesivas
    corrected = re.sub(r'(.)\1{2,}', r'\1\1', corrected)
    
    return corrected

def detect_intent(text):
    text_lower = text.lower()
    
    if re.search(r'qué|cómo|cuándo|dónde|por qué|cuál|cuánto|podés|puedes|sabes', text_lower):
        return "pregunta"
    if re.search(r'abre|ejecuta|corre|inicia|instala|configura|reinicia|apaga|enciende', text_lower):
        return "comando"
    if re.search(r'no funciona|falló|error|problema|mal|roto|lento|trabado', text_lower):
        return "queja"
    if re.search(r'gracias|thanks|genial|perfecto|excelente|buenísimo|joya', text_lower):
        return "agradecimiento"
    if re.search(r'hola|hey|buenas|qué tal|cómo estás|buenos días|buenas tardes', text_lower):
        return "saludo"
    if re.search(r'ayuda|help|no sé|cómo hago|necesito|podés|puedes', text_lower):
        return "ayuda"
    if re.search(r'cuéntame|explícame|qué es|para qué sirve|cómo funciona', text_lower):
        return "información"
    
    return "declaración"

def detect_emotion(text):
    text_lower = text.lower()
    
    if re.search(r'no funciona|mal|error|problema|lento|trabado|cuelga|se congela', text_lower):
        return "frustrado"
    if re.search(r'genial|perfecto|excelente|buenísimo|joya|dale|sí|bien|funciona', text_lower):
        return "contento"
    if re.search(r'rápido|urgente|ya|ahora|necesito|importante|critico|urgente', text_lower):
        return "urgente"
    if re.search(r'qué es|cómo|por qué|cuéntame|explícame|interesante|wow', text_lower):
        return "curioso"
    
    return "neutral"

def detect_topics(text):
    text_lower = text.lower()
    topics = []
    
    topic_patterns = {
        "sistema": r'sistema|computadora|pc|linux|windows|arch',
        "temperatura": r'temperatura|calor|cooling|fan|ventilador|gpu|cpu',
        "scripts": r'script|bash|comando|terminal|sh',
        "aprendizaje": r'aprendizaje|aprender|estudiar|conocimiento|memoria',
        "discord": r'discord|bot|servidor|canal',
        "nexo": r'nexo|asistente|bot|ayudante',
        "archivos": r'archivo|carpeta|directorio|documento',
        "red": r'red|internet|wifi|conexión|ip',
        "ia": r'ia|inteligencia|modelo|gemini|ollama',
    }
    
    for topic, pattern in topic_patterns.items():
        if re.search(pattern, text_lower):
            topics.append(topic)
    
    return ",".join(topics) if topics else "general"

def analyze(message):
    if not message:
        print("Uso: nexo-lang analyze \"mensaje\"")
        return 1
    
    print(f"{Colors.CYAN}🗣️ Análisis de mensaje:{Colors.NC}\n")
    
    corrected = auto_correct(message)
    intent = detect_intent(corrected)
    emotion = detect_emotion(corrected)
    topics = detect_topics(corrected)
    
    print(f"📝 Original: {message}")
    print(f"✅ Corregido: {corrected}")
    print(f"🎯 Intención: {intent}")
    print(f"💭 Emoción: {emotion}")
    print(f"📚 Temas: {topics}")
    
    # Guardar en historial
    entry = {
        "timestamp": datetime.utcnow().isoformat() + "Z",
        "original": message,
        "corrected": corrected,
        "intent": intent,
        "emotion": emotion,
        "topics": topics
    }
    
    entries = load_jsonl(MESSAGES_FILE)
    entries.append(entry)
    save_jsonl(MESSAGES_FILE, entries)
    
    return 0

def style():
    print(f"{Colors.CYAN}🗣️ Estilo del usuario:{Colors.NC}\n")
    
    if not MESSAGES_FILE.exists():
        print("No hay mensajes analizados aún.")
        return 0
    
    entries = load_jsonl(MESSAGES_FILE)
    print(f"📝 Total de mensajes: {len(entries)}")
    
    emotions = [e.get("emotion", "neutral") for e in entries]
    emotion_counts = Counter(emotions)
    
    print("\n💭 Distribución emocional:")
    for emotion, count in emotion_counts.most_common():
        print(f"   {emotion}: {count}")
    
    all_topics = []
    for e in entries:
        topics = e.get("topics", "").split(",")
        all_topics.extend([t for t in topics if t])
    
    topic_counts = Counter(all_topics)
    print("\n📚 Temas más frecuentes:")
    for topic, count in topic_counts.most_common(5):
        print(f"   {topic}: {count}")
    
    return 0

def history():
    if not MESSAGES_FILE.exists():
        print("No hay historial.")
        return 0
    
    entries = load_jsonl(MESSAGES_FILE)
    print("📜 Últimos 10 mensajes:\n")
    
    for entry in entries[-10:]:
        ts = entry.get("timestamp", "")[:19]
        intent = entry.get("intent", "")
        emotion = entry.get("emotion", "")
        text = entry.get("corrected", "")[:50]
        print(f"{ts} | {intent} | {emotion} | {text}")
    
    return 0

def show_help():
    print("""🗣️ Nexo Language Analyzer

Uso:
  nexo-lang analyze "mensaje"   Analizar un mensaje
  nexo-lang correct "texto"     Auto-corregir typos
  nexo-lang style               Ver estilo del usuario
  nexo-lang teach <typo> <corr> Enseñar nuevo typo
  nexo-lang history             Ver historial""")

def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "help"
    
    if cmd in ["--help", "-h", "help"]:
        show_help()
        return 0
    elif cmd == "analyze":
        return analyze(args[1] if len(args) > 1 else "")
    elif cmd == "correct":
        text = args[1] if len(args) > 1 else ""
        print(auto_correct(text))
        return 0
    elif cmd == "style":
        return style()
    elif cmd == "teach":
        print("📝 Typo registrado para futuras correcciones")
        return 0
    elif cmd == "history":
        return history()
    else:
        show_help()
        return 1

if __name__ == "__main__":
    sys.exit(main())
