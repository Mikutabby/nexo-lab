#!/usr/bin/env python3
"""
nexo-deep — Motor de Aprendizaje Profundo de Nexo
"""
import os
import sys
import json
from pathlib import Path
from datetime import datetime

MEMORY_DIR = Path.home() / ".nexo-memory"
DEEP_DIR = MEMORY_DIR / "learned" / "deep"
CAUSAL_GRAPH = DEEP_DIR / "causal_graph.json"
PREDICTIONS = DEEP_DIR / "predictions.jsonl"

DEEP_DIR.mkdir(parents=True, exist_ok=True)

class Colors:
    RED = '\033[0;31m'
    YELLOW = '\033[1;33m'
    CYAN = '\033[0;36m'
    GREEN = '\033[0;32m'
    NC = '\033[0m'

def load_json(filepath, default=None):
    if filepath.exists():
        with open(filepath) as f:
            return json.load(f)
    return default or []

def save_json(filepath, data):
    with open(filepath, "w") as f:
        json.dump(data, f, indent=2)

def analyze(source, error_content=""):
    if not source:
        print("Uso: nexo-deep analyze <archivo_error> [contenido_error]")
        return 1
    
    print(f"{Colors.CYAN}🔬 Análisis causal profundo de: {source}{Colors.NC}\n")
    
    # Leer contenido
    if Path(source).exists():
        content = Path(source).read_text()
    else:
        content = error_content
    
    # Analizar niveles de error
    analysis = {"syntax": 0, "semantic": 0, "runtime": 0, "logic": 0}
    
    # Nivel 1: Sintáctico
    syntax_patterns = ["syntax", "unexpected", "parse", "indent"]
    if any(p in content.lower() for p in syntax_patterns):
        analysis["syntax"] += 1
        print("  🔴 Error sintáctico detectado")
    
    # Nivel 2: Semántico
    semantic_patterns = ["undefined", "not defined", "not found", "does not exist"]
    if any(p in content.lower() for p in semantic_patterns):
        analysis["semantic"] += 1
        print("  🟡 Error semántico detectado")
    
    # Nivel 3: Runtime
    runtime_patterns = ["permission", "denied", "access", "timeout", "connection", "refused"]
    if any(p in content.lower() for p in runtime_patterns):
        analysis["runtime"] += 1
        print("  🟠 Error de runtime detectado")
    
    # Nivel 4: Lógico
    logic_patterns = ["infinite", "loop", "memory", "oom"]
    if any(p in content.lower() for p in logic_patterns):
        analysis["logic"] += 1
        print("  🔴 Error lógico detectado")
    
    # Calcular severidad
    total = sum(analysis.values())
    severity = "baja"
    if total >= 3: severity = "crítica"
    elif total >= 2: severity = "alta"
    elif total >= 1: severity = "media"
    
    print(f"\n📊 Resumen:")
    print(f"   Sintáctico: {analysis['syntax']}")
    print(f"   Semántico: {analysis['semantic']}")
    print(f"   Runtime: {analysis['runtime']}")
    print(f"   Lógico: {analysis['logic']}")
    print(f"   Severidad: {severity}")
    
    # Guardar en grafo causal
    entry = {
        "source": source,
        "severity": severity,
        "analysis": analysis,
        "content_preview": content[:500],
        "timestamp": datetime.utcnow().isoformat() + "Z",
        "resolved": False
    }
    
    graph = load_json(CAUSAL_GRAPH, [])
    graph.append(entry)
    save_json(CAUSAL_GRAPH, graph)
    
    print(f"\n✅ Análisis guardado en grafo causal")
    return 0

def pattern():
    print(f"{Colors.CYAN}🔍 Buscando patrones causales...{Colors.NC}\n")
    
    graph = load_json(CAUSAL_GRAPH, [])
    if not graph:
        print("No hay análisis causales registrados.")
        return 0
    
    total = len(graph)
    syntax = sum(1 for g in graph if g.get("analysis", {}).get("syntax", 0) > 0)
    semantic = sum(1 for g in graph if g.get("analysis", {}).get("semantic", 0) > 0)
    runtime = sum(1 for g in graph if g.get("analysis", {}).get("runtime", 0) > 0)
    logic = sum(1 for g in graph if g.get("analysis", {}).get("logic", 0) > 0)
    
    print(f"📊 Distribución de errores (total: {total}):")
    print(f"   Sintáctico: {syntax} ({syntax * 100 // max(total, 1)}%)")
    print(f"   Semántico: {semantic} ({semantic * 100 // max(total, 1)}%)")
    print(f"   Runtime: {runtime} ({runtime * 100 // max(total, 1)}%)")
    print(f"   Lógico: {logic} ({logic * 100 // max(total, 1)}%)")
    
    # Detectar patrón dominante
    counts = {"sintáctico": syntax, "semántico": semantic, "runtime": runtime, "lógico": logic}
    max_type = max(counts, key=counts.get)
    max_count = counts[max_type]
    
    if max_count > 0:
        print(f"\n🎯 Patrón dominante: {max_type} ({max_count} ocurrencias)")
    
    return 0

def predict(scenario):
    if not scenario:
        print("Uso: nexo-deep predict <escenario>")
        return 1
    
    print(f"{Colors.CYAN}🔮 Predicción para: {scenario}{Colors.NC}\n")
    
    graph = load_json(CAUSAL_GRAPH, [])
    
    # Contar errores similares
    similar = sum(1 for g in graph 
                  if scenario.lower() in g.get("content_preview", "").lower() or
                     scenario.lower() in g.get("source", "").lower())
    
    print(f"📊 Errores similares en historial: {similar}\n")
    
    if similar > 3:
        print("⚠️  RIESGO ALTO: Hay múltiples errores similares previos")
    elif similar > 0:
        print("⚡ RIESGO MEDIO: Hay algunos errores similares")
    else:
        print("✅ RIESGO BAJO: No hay errores similares conocidos")
    
    return 0

def simulate(scenario):
    if not scenario:
        print("Uso: nexo-deep simulate <escenario>")
        return 1
    
    print(f"{Colors.CYAN}🧪 Simulación mental: {scenario}{Colors.NC}\n")
    print("Pensando paso a paso...\n")
    print("📋 Componentes involucrados:")
    print("  • [Identificar archivos/programas/usuarios]")
    print("  • [Identificar dependencias]\n")
    print("🔄 Secuencia probable:")
    print("  1. [Acción inicial]")
    print("  2. [Respuesta del sistema]\n")
    print("⚠️  Puntos de fallo potenciales:")
    print("  • [Permiso insuficiente]")
    print("  • [Archivo no encontrado]\n")
    print("💡 Simulación completada.")
    return 0

def explain():
    print(f"{Colors.CYAN}📖 Lo que he aprendido:{Colors.NC}\n")
    
    graph = load_json(CAUSAL_GRAPH, [])
    if graph:
        print(f"📊 De {len(graph)} análisis causales:\n")
        print("🔧 Principios que descubrí:\n")
        
        for g in graph:
            analysis = g.get("analysis", {})
            if analysis.get("syntax", 0) > 0:
                print("  📝 Errores de sintaxis: Revisar siempre la estructura")
            if analysis.get("semantic", 0) > 0:
                print("  🔍 Errores semánticos: Verificar que todo exista")
            if analysis.get("runtime", 0) > 0:
                print("  ⚡ Errores de runtime: Prepararse para el entorno")
            if analysis.get("logic", 0) > 0:
                print("  🧠 Errores lógicos: Pensar en casos extremos")
            break
    
    print(f"\n🎓 Nivel de aprendizaje: En progreso")
    return 0

def show_help():
    print("""🔬 Nexo Deep Learning Engine

Uso:
  nexo-deep analyze <file>     Análisis causal profundo
  nexo-deep pattern            Buscar patrones causales
  nexo-deep predict <scenario> Predecir qué podría fallar
  nexo-deep simulate <scenario> Simular escenario mental
  nexo-deep explain            Explicar lo que aprendí""")

def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "help"
    
    if cmd in ["--help", "-h", "help"]:
        show_help()
        return 0
    elif cmd == "analyze":
        return analyze(args[1] if len(args) > 1 else "",
                      args[2] if len(args) > 2 else "")
    elif cmd == "pattern":
        return pattern()
    elif cmd == "predict":
        return predict(args[1] if len(args) > 1 else "")
    elif cmd == "simulate":
        return simulate(args[1] if len(args) > 1 else "")
    elif cmd == "explain":
        return explain()
    else:
        show_help()
        return 1

if __name__ == "__main__":
    sys.exit(main())
