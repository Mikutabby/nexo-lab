#!/usr/bin/env python3
"""
nexo-learn — Sistema de Aprendizaje Autónomo de Nexo
"""
import os
import sys
import json
import subprocess
from pathlib import Path
from datetime import datetime

MEMORY_DIR = Path.home() / ".nexo-memory"
LEARN_DIR = MEMORY_DIR / "learned"
CAUSAL_DIR = LEARN_DIR / "causal"
JOURNAL_FILE = LEARN_DIR / "journal.jsonl"
HYPOTHESIS_FILE = LEARN_DIR / "hypotheses.json"
COMPREHENSION_FILE = LEARN_DIR / "comprehension.json"
OBSERVATIONS_FILE = LEARN_DIR / "observations.jsonl"

CAUSAL_DIR.mkdir(parents=True, exist_ok=True)

class Colors:
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    CYAN = '\033[0;36m'
    RED = '\033[0;31m'
    NC = '\033[0m'

def ok(msg): print(f"{Colors.GREEN}✅ {msg}{Colors.NC}")
def info(msg): print(f"{Colors.CYAN}{msg}{Colors.NC}")
def warn(msg): print(f"{Colors.YELLOW}⚠️  {msg}{Colors.NC}")
def err(msg): print(f"{Colors.RED}❌ {msg}{Colors.NC}", file=sys.stderr)

def load_jsonl(filepath):
    entries = []
    if filepath.exists():
        with open(filepath) as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        entries.append(json.loads(line))
                    except json.JSONDecodeError:
                        continue
    return entries

def save_jsonl(filepath, entries):
    with open(filepath, "w") as f:
        for entry in entries:
            f.write(json.dumps(entry) + "\n")

def load_json(filepath, default=None):
    if filepath.exists():
        with open(filepath) as f:
            return json.load(f)
    return default or {}

def save_json(filepath, data):
    with open(filepath, "w") as f:
        json.dump(data, f, indent=2)

def observe(event_type, description, context="", attempted="", result=""):
    if not event_type:
        err("Uso: nexo-learn observe <error|success|pattern|insight> <desc>")
        return 1
    
    timestamp = datetime.utcnow().isoformat() + "Z"
    entry = {
        "timestamp": timestamp,
        "event_type": event_type,
        "description": description,
        "context": context,
        "attempted": attempted,
        "result": result,
        "analyzed": False,
        "hypothesis_id": None
    }
    
    entries = load_jsonl(OBSERVATIONS_FILE)
    entries.append(entry)
    save_jsonl(OBSERVATIONS_FILE, entries)
    
    if event_type == "error":
        analyze_error(description, context, attempted)
    
    ok(f"Observación registrada: {event_type}")
    print(f"   {description}")
    return 0

def analyze_error(error_desc, context="", attempted=""):
    cause_analysis = ""
    
    error_patterns = {
        "not found|no existe|missing": "El archivo/directorio no existe o fue movido",
        "permission|denied|acceso": "Falta permiso. Verificar sudoers o ownership",
        "connection|timeout|refused": "Servicio no disponible o red caída",
        "syntax|unexpected|parse": "Error de sintaxis en código o comando",
        "memory|oom|resource": "Recursos del sistema agotados"
    }
    
    for patterns, cause in error_patterns.items():
        if any(p in error_desc.lower() for p in patterns.split("|")):
            cause_analysis = f"Causa probable: {cause}"
            break
    
    if not cause_analysis:
        cause_analysis = "Causa desconocida — necesita investigación profunda"
    
    analysis = {
        "error": error_desc,
        "cause_analysis": cause_analysis,
        "context": context,
        "attempted_fix": attempted,
        "timestamp": datetime.utcnow().isoformat()
    }
    
    analysis_file = CAUSAL_DIR / f"{datetime.now().strftime('%Y%m%d_%H%M%S')}_error.json"
    save_json(analysis_file, analysis)
    
    print(f"{Colors.YELLOW}🔍 Análisis de error:{Colors.NC}")
    print(f"   Error: {error_desc}")
    print(f"   {cause_analysis}")
    print(f"   Guardado en: {analysis_file}")

def hypothesize(hypothesis, confidence=0.5, evidence=""):
    if not hypothesis:
        err("Uso: nexo-learn hypothesize <hipótesis> [confianza 0-1] [evidencia]")
        return 1
    
    hypotheses = load_json(HYPOTHESIS_FILE, [])
    
    new_hyp = {
        "id": f"hyp_{int(datetime.now().timestamp())}",
        "hypothesis": hypothesis,
        "confidence": confidence,
        "evidence": evidence,
        "times_tested": 0,
        "times_confirmed": 0,
        "times_rejected": 0,
        "created": datetime.utcnow().isoformat() + "Z",
        "last_tested": None,
        "status": "active"
    }
    
    hypotheses.append(new_hyp)
    save_json(HYPOTHESIS_FILE, hypotheses)
    
    print(f"{Colors.CYAN}💡 Hipótesis formulada:{Colors.NC}")
    print(f"   ID: {new_hyp['id']}")
    print(f"   {hypothesis}")
    print(f"   Confianza inicial: {confidence}")
    return 0

def test_hypothesis(hypothesis_id, experiment, outcome):
    if not hypothesis_id:
        err("Uso: nexo-learn test <hypothesis_id> <experimento> <confirmed|rejected|inconclusive>")
        return 1
    
    hypotheses = load_json(HYPOTHESIS_FILE, [])
    
    for hyp in hypotheses:
        if hyp["id"] == hypothesis_id:
            hyp["times_tested"] += 1
            
            if outcome == "confirmed":
                hyp["times_confirmed"] += 1
                hyp["confidence"] = min(1.0, hyp["confidence"] * 1.2)
                hyp["status"] = "validated"
            elif outcome == "rejected":
                hyp["times_rejected"] += 1
                hyp["confidence"] = max(0.0, hyp["confidence"] * 0.8)
                if hyp["confidence"] < 0.1:
                    hyp["status"] = "discarded"
            
            hyp["last_tested"] = datetime.utcnow().isoformat() + "Z"
            break
    else:
        err(f"Hipótesis {hypothesis_id} no encontrada")
        return 1
    
    save_json(HYPOTHESIS_FILE, hypotheses)
    
    print(f"{Colors.YELLOW}🧪 Experimento registrado:{Colors.NC}")
    print(f"   Hipótesis: {hypothesis_id}")
    print(f"   Resultado: {outcome}")
    return 0

def reflect():
    print(f"{Colors.CYAN}🪞 Reflexión de aprendizaje:{Colors.NC}\n")
    
    observations = load_jsonl(OBSERVATIONS_FILE)
    
    errors = sum(1 for o in observations if o.get("event_type") == "error")
    success = sum(1 for o in observations if o.get("event_type") == "success")
    patterns = sum(1 for o in observations if o.get("event_type") == "pattern")
    insights = sum(1 for o in observations if o.get("event_type") == "insight")
    
    print("📊 Resumen de observaciones:")
    print(f"   Errores: {errors}")
    print(f"   Éxitos: {success}")
    print(f"   Patrones: {patterns}")
    print(f"   Insights: {insights}\n")
    
    hypotheses = load_json(HYPOTHESIS_FILE, [])
    if hypotheses:
        validated = sum(1 for h in hypotheses if h.get("status") == "validated")
        discarded = sum(1 for h in hypotheses if h.get("status") == "discarded")
        active = sum(1 for h in hypotheses if h.get("status") == "active")
        
        print("💡 Hipótesis:")
        print(f"   Totales: {len(hypotheses)}")
        print(f"   Validadas: {validated}")
        print(f"   Descartadas: {discarded}")
        print(f"   Activas: {active}\n")
        
        if hypotheses:
            sorted_hyps = sorted(hypotheses, key=lambda x: x.get("confidence", 0), reverse=True)
            print("🏆 Hipótesis más fuertes:")
            for h in sorted_hyps[:3]:
                conf = int(h.get("confidence", 0) * 100)
                print(f"   [{conf}%] {h.get('hypothesis', '')}")
    
    return 0

def comprehend(topic):
    if not topic:
        err("Uso: nexo-learn comprehend <tema>")
        return 1
    
    print(f"{Colors.CYAN}🧠 Verificando comprensión de: {topic}{Colors.NC}\n")
    
    comprehension = load_json(COMPREHENSION_FILE)
    
    print("Niveles de comprensión:")
    print("  1. 📝 MEMORIZÉ — Recuerdo el hecho")
    print("  2. 🔗 CONEXIÓN — Sé cómo se relaciona")
    print("  3. ⚡ APLIQUÉ — Puedo usarlo en contexto nuevo")
    print("  4. 🎯 EXPLIQUÉ — Puedo enseñárselo a alguien")
    print("  5. 🔧 CREÉ — Puedo crear algo nuevo\n")
    
    try:
        level = int(input("¿En qué nivel estoy? (1-5): "))
        if level < 1 or level > 5:
            raise ValueError
    except (ValueError, EOFError):
        err("Nivel inválido")
        return 1
    
    comprehension[topic] = {
        "level": level,
        "tested_at": datetime.utcnow().isoformat() + "Z",
        "next_review": datetime.utcnow().isoformat() + "Z"
    }
    
    save_json(COMPREHENSION_FILE, comprehension)
    
    messages = {
        1: "📝 Memorización base. Necesito practicar para subir.",
        2: "🔗 Estoy conectando conceptos. Seguir explorando.",
        3: "⚡ Buena aplicación práctica. Intentar escenarios nuevos.",
        4: "🎯 Comprensión sólida. Puedo explicar con confianza.",
        5: "🏆 Maestría. Puedo crear y enseñar."
    }
    
    print(f"\n{messages[level]}")
    return 0

def teach(topic, source=""):
    if not topic:
        err("Uso: nexo-learn teach <tema> [fuente]")
        return 1
    
    print(f"{Colors.CYAN}📚 Aprendiendo: {topic}{Colors.NC}\n")
    
    # Verificar knowledge graph
    try:
        result = subprocess.run(["nexo-graph", "search", topic], capture_output=True, text=True)
        if result.stdout.strip():
            print("  Ya tengo información:")
            for line in result.stdout.strip().split('\n')[:3]:
                print(f"    {line}")
        else:
            print("  Es nuevo para mí.")
    except:
        print("  (nexo-graph no disponible)")
    
    print("\n¿Qué quiero aprender?")
    print("  • Definición fundamental")
    print("  • Cómo funciona internamente")
    print("  • Casos de uso prácticos")
    print("  • Errores comunes")
    print("  • Relación con otros conceptos")
    
    entry = {
        "timestamp": datetime.utcnow().isoformat() + "Z",
        "type": "learning_session",
        "topic": topic,
        "source": source,
        "status": "in_progress"
    }
    
    with open(JOURNAL_FILE, "a") as f:
        f.write(json.dumps(entry) + "\n")
    
    print(f"\n🎓 Sesión de aprendizaje iniciada para: {topic}")
    return 0

def journal(lines=20):
    print(f"{Colors.CYAN}📔 Diario de aprendizaje:{Colors.NC}\n")
    
    if not JOURNAL_FILE.exists():
        print("El diario está vacío. Empezá a aprender con:")
        print("  nexo-learn observe ...")
        print("  nexo-learn teach ...")
        return 0
    
    entries = load_jsonl(JOURNAL_FILE)
    for entry in entries[-lines:]:
        ts = entry.get("timestamp", "")
        typ = entry.get("type", "")
        topic = entry.get("topic", entry.get("summary", "reflexión"))
        print(f"{ts} | {typ} | {topic}")
    
    return 0

def status():
    print(f"{Colors.CYAN}🧠 Estado de aprendizaje autónomo:{Colors.NC}\n")
    
    observations = load_jsonl(OBSERVATIONS_FILE)
    print(f"📝 Observaciones: {len(observations)}")
    
    hypotheses = load_json(HYPOTHESIS_FILE, [])
    validated = sum(1 for h in hypotheses if h.get("status") == "validated")
    print(f"💡 Hipótesis: {len(hypotheses)} ({validated} validadas)")
    
    comprehension = load_json(COMPREHENSION_FILE)
    print(f"🧠 Temas comprendidos: {len(comprehension)}")
    
    causal_files = list(CAUSAL_DIR.glob("*_error.json"))
    print(f"🔍 Análisis causales: {len(causal_files)}")
    
    if JOURNAL_FILE.exists():
        entries = load_jsonl(JOURNAL_FILE)
        print(f"📔 Entradas en diario: {len(entries)}")
    
    return 0

def show_help():
    print("""🧠 Nexo Autonomous Learning System

Uso:
  nexo-learn observe <tipo> <desc>     Registrar evento
  nexo-learn hypothesize <hip>         Formular hipótesis
  nexo-learn test <id> <exp> <res>     Probar hipótesis
  nexo-learn reflect [periodo]         Reflexionar
  nexo-learn comprehend <tema>         Verificar comprensión
  nexo-learn teach <tema> [fuente]     Aprender algo nuevo
  nexo-learn journal [líneas]          Ver diario
  nexo-learn status                    Ver estado""")

def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "status"
    
    if cmd in ["--help", "-h"]:
        show_help()
        return 0
    elif cmd == "observe":
        return observe(args[1] if len(args) > 1 else "",
                      args[2] if len(args) > 2 else "",
                      args[3] if len(args) > 3 else "",
                      args[4] if len(args) > 4 else "")
    elif cmd == "hypothesize":
        conf = float(args[2]) if len(args) > 2 else 0.5
        return hypothesize(args[1] if len(args) > 1 else "", conf)
    elif cmd == "test":
        return test_hypothesis(args[1] if len(args) > 1 else "",
                              args[2] if len(args) > 2 else "",
                              args[3] if len(args) > 3 else "")
    elif cmd == "reflect":
        return reflect()
    elif cmd == "comprehend":
        return comprehend(args[1] if len(args) > 1 else "")
    elif cmd == "teach":
        return teach(args[1] if len(args) > 1 else "",
                    args[2] if len(args) > 2 else "")
    elif cmd == "journal":
        lines = int(args[1]) if len(args) > 1 else 20
        return journal(lines)
    elif cmd == "status":
        return status()
    else:
        show_help()
        return 1

if __name__ == "__main__":
    sys.exit(main())
