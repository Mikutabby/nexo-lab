#!/bin/bash
# 🧠 Nexo Autonomous Learning System
# No solo memoriza errores — COMPRENDE por qué fallan y aprende a resolverlos
#
# Uso:
#   nexo-learn observe <event>      → Observar un evento (error, éxito, patrón)
#   nexo-learn hypothesize          → Formular hipótesis sobre causas
#   nexo-learn test <hypothesis>    → Probar una hipótesis
#   nexo-learn reflect              → Reflexionar sobre experiencias recientes
#   nexo-learn comprehend           → Verificar si realmente comprendo algo
#   nexo-learn teach <topic>        → Enseñarme algo nuevo (deep learning)
#   nexo-learn status               → Ver mi nivel de comprensión
#   nexo-learn journal              → Ver diario de aprendizaje

set -uo pipefail

MEMORY_DIR="$HOME/.nexo-memory"
LEARN_DIR="$MEMORY_DIR/learned"
CAUSAL_DIR="$LEARN_DIR/causal"
JOURNAL_FILE="$LEARN_DIR/journal.jsonl"
HYPOTHESIS_FILE="$LEARN_DIR/hypotheses.json"
COMPREHENSION_FILE="$LEARN_DIR/comprehension.json"
OBSERVATIONS_FILE="$LEARN_DIR/observations.jsonl"

mkdir -p "$CAUSAL_DIR"

# ── Colores ──────────────────────────────────────────────────────────────────
G='\033[0;32m'; Y='\033[1;33m'; C='\033[0;36m'; R='\033[0;31m'; NC='\033[0m'

# ══════════════════════════════════════════════════════════════════════════════
# 1. OBSERVE — Registrar un evento con contexto completo
# ══════════════════════════════════════════════════════════════════════════════
observe() {
    local event_type="${1:-}"  # error, success, pattern, insight
    local description="${2:-}"
    local context="${3:-}"
    local attempted="${4:-}"
    local result="${5:-}"
    
    [ -z "$event_type" ] && echo "Uso: nexo-learn observe <error|success|pattern|insight> <desc> [context] [attempted] [result]" && exit 1
    
    local timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local entry=$(jq -n \
        --arg ts "$timestamp" \
        --arg type "$event_type" \
        --arg desc "$description" \
        --arg ctx "$context" \
        --arg attempt "$attempted" \
        --arg result "$result" \
        '{
            timestamp: $ts,
            event_type: $type,
            description: $desc,
            context: $ctx,
            attempted: $attempt,
            result: $result,
            analyzed: false,
            hypothesis_id: null
        }')
    
    echo "$entry" >> "$OBSERVATIONS_FILE"
    
    # Si es un error, analizar inmediatamente
    if [ "$event_type" = "error" ]; then
        analyze_error "$description" "$context" "$attempted"
    fi
    
    echo -e "${G}✅ Observación registrada: ${event_type}${NC}"
    echo "   $description"
}

# ══════════════════════════════════════════════════════════════════════════════
# 2. ANALYZE_ERROR — Diagnosticar POR QUÉ falló algo
# ══════════════════════════════════════════════════════════════════════════════
analyze_error() {
    local error_desc="${1:-}"
    local context="${2:-}"
    local attempted="${3:-}"
    
    # Buscar errores similares en el historial
    local similar_count=0
    local common_causes=""
    
    if [ -f "$OBSERVATIONS_FILE" ]; then
        similar_count=$(grep -c "error" "$OBSERVATIONS_FILE" 2>/dev/null || echo "0")
    fi
    
    # Buscar en el knowledge graph
    local graph_errors=""
    if command -v nexo-graph &>/dev/null; then
        graph_errors=$(nexo-graph search "error $error_desc" 2>/dev/null | head -5)
    fi
    
    # Analizar causas potenciales
    local cause_analysis=""
    
    # Patrón 1: Archivo no encontrado
    if echo "$error_desc" | grep -qi "not found\|no existe\|missing"; then
        cause_analysis="Causa probable: El archivo/directorio no existe o fue movido. Verificar路径."
    # Patrón 2: Permiso denegado
    elif echo "$error_desc" | grep -qi "permission\|denied\|acceso"; then
        cause_analysis="Causa probable: Falta permiso. Verificar sudoers o ownership."
    # Patrón 3: Conexión
    elif echo "$error_desc" | grep -qi "connection\|timeout\|refused"; then
        cause_analysis="Causa probable: Servicio no disponible o red caída."
    # Patrón 4: Sintaxis
    elif echo "$error_desc" | grep -qi "syntax\|unexpected\|parse"; then
        cause_analysis="Causa probable: Error de sintaxis en código o comando."
    # Patrón 5: Memoria/Recursos
    elif echo "$error_desc" | grep -qi "memory\|oom\|resource"; then
        cause_analysis="Causa probable: Recursos del sistema agotados."
    else
        cause_analysis="Causa desconocida — necesita investigación profunda."
    fi
    
    # Registrar análisis
    local analysis=$(jq -n \
        --arg error "$error_desc" \
        --arg cause "$cause_analysis" \
        --arg similar "$similar_count" \
        --arg graph "$graph_errors" \
        --arg attempted "$attempted" \
        '{
            error: $error,
            cause_analysis: $cause,
            similar_errors_seen: ($similar | tonumber),
            graph_references: $graph,
            attempted_fix: $attempted,
            timestamp: now | todate
        }')
    
    local analysis_file="$CAUSAL_DIR/$(date +%Y%m%d_%H%M%S)_error.json"
    echo "$analysis" | jq . > "$analysis_file"
    
    echo -e "${Y}🔍 Análisis de error:${NC}"
    echo "   Error: $error_desc"
    echo "   $cause_analysis"
    echo "   Guardado en: $analysis_file"
}

# ══════════════════════════════════════════════════════════════════════════════
# 3. HYPOTHESIZE — Formular hipótesis sobre causas recurrentes
# ══════════════════════════════════════════════════════════════════════════════
hypothesize() {
    local hypothesis="${1:-}"
    local confidence="${2:-0.5}"
    local evidence="${3:-}"
    
    [ -z "$hypothesis" ] && echo "Uso: nexo-learn hypothesize <hipótesis> [confianza 0-1] [evidencia]" && exit 1
    
    # Cargar hipótesis existentes
    local hypotheses="[]"
    if [ -f "$HYPOTHESIS_FILE" ]; then
        hypotheses=$(cat "$HYPOTHESIS_FILE")
    fi
    
    local id="hyp_$(date +%s)"
    local new_hyp=$(jq -n \
        --arg id "$id" \
        --arg hyp "$hypothesis" \
        --arg conf "$confidence" \
        --arg evid "$evidence" \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{
            id: $id,
            hypothesis: $hyp,
            confidence: ($conf | tonumber),
            evidence: $evid,
            times_tested: 0,
            times_confirmed: 0,
            times_rejected: 0,
            created: $ts,
            last_tested: null,
            status: "active"
        }')
    
    hypotheses=$(echo "$hypotheses" | jq --argjson new "$new_hyp" '. + [$new]')
    echo "$hypotheses" | jq . > "$HYPOTHESIS_FILE"
    
    echo -e "${C}💡 Hipótesis formulada:${NC}"
    echo "   ID: $id"
    echo "   $hypothesis"
    echo "   Confianza inicial: $confidence"
}

# ══════════════════════════════════════════════════════════════════════════════
# 4. TEST — Probar una hipótesis con un experimento
# ══════════════════════════════════════════════════════════════════════════════
test_hypothesis() {
    local hypothesis_id="${1:-}"
    local experiment="${2:-}"
    local outcome="${3:-}"  # confirmed, rejected, inconclusive
    
    [ -z "$hypothesis_id" ] && echo "Uso: nexo-learn test <hypothesis_id> <experimento> <confirmed|rejected|inconclusive>" && exit 1
    
    if [ ! -f "$HYPOTHESIS_FILE" ]; then
        echo "No hay hipótesis registradas."
        return 1
    fi
    
    # Actualizar hipótesis
    local updated=$(jq \
        --arg id "$hypothesis_id" \
        --arg outcome "$outcome" \
        --arg exp "$experiment" \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '
        map(
            if .id == $id then
                .times_tested += 1 |
                if $outcome == "confirmed" then
                    .times_confirmed += 1 |
                    .confidence = ((.confidence * .times_tested + 0.2) / (.times_tested + 1)) |
                    .status = "validated"
                elif $outcome == "rejected" then
                    .times_rejected += 1 |
                    .confidence = ((.confidence * .times_tested - 0.1) / (.times_tested + 1)) |
                    if .confidence < 0.1 then .status = "discarded" else . end
                else
                    . end
                .last_tested = $ts
            else . end
        )' "$HYPOTHESIS_FILE")
    
    echo "$updated" | jq . > "$HYPOTHESIS_FILE"
    
    local new_conf=$(echo "$updated" | jq -r --arg id "$hypothesis_id" '.[] | select(.id == $id) | .confidence')
    
    echo -e "${Y}🧪 Experimento registrado:${NC}"
    echo "   Hipótesis: $hypothesis_id"
    echo "   Resultado: $outcome"
    echo "   Nueva confianza: $new_conf"
}

# ══════════════════════════════════════════════════════════════════════════════
# 5. REFLECT — Reflexionar sobre experiencias recientes
# ══════════════════════════════════════════════════════════════════════════════
reflect() {
    local period="${1:-today}"  # today, week, all
    
    echo -e "${C}🪞 Reflexión de aprendizaje:${NC}"
    echo ""
    
    if [ ! -f "$OBSERVATIONS_FILE" ]; then
        echo "No hay observaciones para reflexionar."
        return 0
    fi
    
    # Contar por tipo
    local total_errors=$(grep -c '"event_type":"error"' "$OBSERVATIONS_FILE" 2>/dev/null || echo "0")
    local total_success=$(grep -c '"event_type":"success"' "$OBSERVATIONS_FILE" 2>/dev/null || echo "0")
    local total_patterns=$(grep -c '"event_type":"pattern"' "$OBSERVATIONS_FILE" 2>/dev/null || echo "0")
    local total_insights=$(grep -c '"event_type":"insight"' "$OBSERVATIONS_FILE" 2>/dev/null || echo "0")
    
    echo "📊 Resumen de observaciones:"
    echo "   Errores: $total_errors"
    echo "   Éxitos: $total_success"
    echo "   Patrones: $total_patterns"
    echo "   Insights: $total_insights"
    echo ""
    
    # Análisis de hipótesis
    if [ -f "$HYPOTHESIS_FILE" ]; then
        local total_hyp=$(jq 'length' "$HYPOTHESIS_FILE")
        local validated=$(jq '[.[] | select(.status == "validated")] | length' "$HYPOTHESIS_FILE")
        local discarded=$(jq '[.[] | select(.status == "discarded")] | length' "$HYPOTHESIS_FILE")
        local active=$(jq '[.[] | select(.status == "active")] | length' "$HYPOTHESIS_FILE")
        
        echo "💡 Hipótesis:"
        echo "   Totales: $total_hyp"
        echo "   Validadas: $validated"
        echo "   Descartadas: $discarded"
        echo "   Activas: $active"
        echo ""
        
        # Mostrar hipótesis más fuertes
        echo "🏆 Hipótesis más fuertes:"
        jq -r 'sort_by(-.confidence) | .[0:3][] | "   [\(.confidence | . * 100 | round)%] \(.hypothesis)"' "$HYPOTHESIS_FILE" 2>/dev/null
    fi
    
    # Patrones de error recurrentes
    echo ""
    echo "🔄 Errores recurrentes (causas raíz):"
    if [ -d "$CAUSAL_DIR" ]; then
        ls "$CAUSAL_DIR"/*_error.json 2>/dev/null | tail -5 | while read f; do
            local err=$(jq -r '.error' "$f" 2>/dev/null)
            local cause=$(jq -r '.cause_analysis' "$f" 2>/dev/null)
            echo "   • $err"
            echo "     → $cause"
        done
    fi
    
    # Guardar reflexión en journal
    local reflection=$(jq -n \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --argjson errors "$total_errors" \
        --argjson success "$total_success" \
        --argjson patterns "$total_patterns" \
        --argjson insights "$total_insights" \
        '{
            timestamp: $ts,
            type: "reflection",
            summary: {
                errors: $errors,
                success: $success,
                patterns: $patterns,
                insights: $insights
            }
        }')
    
    echo "$reflection" >> "$JOURNAL_FILE"
}

# ══════════════════════════════════════════════════════════════════════════════
# 6. COMPREHEND — Verificar si realmente comprendo algo
# ══════════════════════════════════════════════════════════════════════════════
comprehend() {
    local topic="${1:-}"
    
    [ -z "$topic" ] && echo "Uso: nexo-learn comprehend <tema>" && exit 1
    
    echo -e "${C}🧠 Verificando comprensión de: $topic${NC}"
    echo ""
    
    # Cargar comprensión existente
    local comprehension="{}"
    if [ -f "$COMPREHENSION_FILE" ]; then
        comprehension=$(cat "$COMPREHENSION_FILE")
    fi
    
    # Niveles de comprensión
    echo "Niveles de comprensión:"
    echo "  1. 📝 MEMORIZÉ — Recuerdo el hecho"
    echo "  2. 🔗 CONEXIÓN — Sé cómo se relaciona con otros conceptos"
    echo "  3. ⚡ APLIQUÉ — Puedo usarlo en un contexto nuevo"
    echo "  4. 🎯 EXPLIQUÉ — Puedo enseñárselo a alguien"
    echo "  5. 🔧 CREÉ — Puedo crear algo nuevo con ese conocimiento"
    echo ""
    echo -n "¿En qué nivel estoy? (1-5): "
    read -r level
    
    # Guardar nivel de comprensión
    comprehension=$(echo "$comprehension" | jq \
        --arg topic "$topic" \
        --arg level "$level" \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '.[$topic] = {
            level: ($level | tonumber),
            tested_at: $ts,
            next_review: (now + 86400 | todate)
        }')
    
    echo "$comprehension" | jq . > "$COMPREHENSION_FILE"
    
    echo ""
    case $level in
        1) echo "📝 Memorización base. Necesito practicar para subir." ;;
        2) echo "🔗 Estoy conectando conceptos. Seguir explorando." ;;
        3) echo "⚡ Buena aplicación práctica. Intentar escenarios nuevos." ;;
        4) echo "🎯 Comprensión sólida. Puedo explicar con confianza." ;;
        5) echo "🏆 Maestría. Puedo crear y enseñar." ;;
    esac
}

# ══════════════════════════════════════════════════════════════════════════════
# 7. TEACH — Aprender algo nuevo de forma profunda
# ══════════════════════════════════════════════════════════════════════════════
teach() {
    local topic="${1:-}"
    local source="${2:-}"
    
    [ -z "$topic" ] && echo "Uso: nexo-learn teach <tema> [fuente]" && exit 1
    
    echo -e "${C}📚 Aprendiendo: $topic${NC}"
    echo ""
    
    # Paso 1: ¿Qué sé ya?
    echo "Paso 1: ¿Qué sé sobre esto?"
    echo "  (verificar knowledge graph)"
    if command -v nexo-graph &>/dev/null; then
        local existing=$(nexo-graph search "$topic" 2>/dev/null | head -3)
        if [ -n "$existing" ]; then
            echo "  Ya tengo información:"
            echo "$existing" | head -3
        else
            echo "  Es nuevo para mí."
        fi
    fi
    
    echo ""
    echo "Paso 2: ¿Qué quiero aprender?"
    echo "  • Definición fundamental"
    echo "  • Cómo funciona internamente"
    echo "  • Casos de uso prácticos"
    echo "  • Errores comunes"
    echo "  • Relación con otros conceptos"
    
    echo ""
    echo "Paso 3: Verificar comprensión"
    echo "  Después de aprender, ejecutá:"
    echo "  nexo-learn comprehend \"$topic\""
    
    # Registrar en journal
    local entry=$(jq -n \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg topic "$topic" \
        --arg source "$source" \
        '{
            timestamp: $ts,
            type: "learning_session",
            topic: $topic,
            source: $source,
            status: "in_progress"
        }')
    
    echo "$entry" >> "$JOURNAL_FILE"
    
    echo ""
    echo "🎓 Sesión de aprendizaje iniciada para: $topic"
}

# ══════════════════════════════════════════════════════════════════════════════
# 8. JOURNAL — Ver diario de aprendizaje
# ══════════════════════════════════════════════════════════════════════════════
journal() {
    local lines="${1:-20}"
    
    echo -e "${C}📔 Diario de aprendizaje:${NC}"
    echo ""
    
    if [ -f "$JOURNAL_FILE" ]; then
        tail -n "$lines" "$JOURNAL_FILE" | jq -r '
            "\(.timestamp) | \(.type) | \(.topic // .summary // "reflexión")"
        ' 2>/dev/null
    else
        echo "El diario está vacío. Empezá a aprender con:"
        echo "  nexo-learn observe ..."
        echo "  nexo-learn teach ..."
    fi
}

# ══════════════════════════════════════════════════════════════════════════════
# 9. STATUS — Ver estado de aprendizaje
# ══════════════════════════════════════════════════════════════════════════════
status() {
    echo -e "${C}🧠 Estado de aprendizaje autónomo:${NC}"
    echo ""
    
    # Observaciones
    local obs_count=0
    [ -f "$OBSERVATIONS_FILE" ] && obs_count=$(wc -l < "$OBSERVATIONS_FILE")
    echo "📝 Observaciones: $obs_count"
    
    # Hipótesis
    if [ -f "$HYPOTHESIS_FILE" ]; then
        local hyp_count=$(jq 'length' "$HYPOTHESIS_FILE")
        local validated=$(jq '[.[] | select(.status == "validated")] | length' "$HYPOTHESIS_FILE")
        echo "💡 Hipótesis: $hyp_count ($validated validadas)"
    else
        echo "💡 Hipótesis: 0"
    fi
    
    # Comprensión
    if [ -f "$COMPREHENSION_FILE" ]; then
        local comp_count=$(jq 'length' "$COMPREHENSION_FILE")
        local avg_level=$(jq '[.[].level] | add / length' "$COMPREHENSION_FILE" 2>/dev/null || echo "0")
        echo "🧠 Temas comprendidos: $comp_count (nivel promedio: $avg_level)"
    else
        echo "🧠 Temas comprendidos: 0"
    fi
    
    # Análisis causales
    if [ -d "$CAUSAL_DIR" ]; then
        local causal_count=$(ls "$CAUSAL_DIR"/*_error.json 2>/dev/null | wc -l)
        echo "🔍 Análisis causales: $causal_count"
    else
        echo "🔍 Análisis causales: 0"
    fi
    
    # Journal entries
    if [ -f "$JOURNAL_FILE" ]; then
        local journal_count=$(wc -l < "$JOURNAL_FILE")
        echo "📔 Entradas en diario: $journal_count"
    else
        echo "📔 Entradas en diario: 0"
    fi
}

# ══════════════════════════════════════════════════════════════════════════════
# MAIN
# ══════════════════════════════════════════════════════════════════════════════
case "${1:-status}" in
    observe)
        shift
        observe "$@"
        ;;
    hypothesize)
        shift
        hypothesize "$@"
        ;;
    test)
        shift
        test_hypothesis "$@"
        ;;
    reflect)
        shift
        reflect "$@"
        ;;
    comprehend)
        shift
        comprehend "$@"
        ;;
    teach)
        shift
        teach "$@"
        ;;
    journal)
        shift
        journal "$@"
        ;;
    status)
        status
        ;;
    *)
        echo "Uso: nexo-learn <comando>"
        echo ""
        echo "Comandos:"
        echo "  observe <tipo> <desc>   → Registrar evento"
        echo "  hypothesize <hip>       → Formular hipótesis"
        echo "  test <id> <exp> <res>   → Probar hipótesis"
        echo "  reflect [periodo]       → Reflexionar"
        echo "  comprehend <tema>       → Verificar comprensión"
        echo "  teach <tema> [fuente]   → Aprender algo nuevo"
        echo "  journal [líneas]        → Ver diario"
        echo "  status                  → Ver estado"
        ;;
esac
