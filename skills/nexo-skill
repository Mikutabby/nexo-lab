#!/usr/bin/env python3
"""
nexo-skill — Sistema de Skills (plugins) para Nexo
"""
import os
import sys
import json
import shutil
from pathlib import Path

SKILLS_DIR = Path.home() / ".nexo-skills"
REGISTRY_FILE = SKILLS_DIR / ".registry.json"

def load_registry():
    if REGISTRY_FILE.exists():
        with open(REGISTRY_FILE) as f:
            return json.load(f)
    else:
        registry = {"skills": {}}
        save_registry(registry)
        return registry

def save_registry(registry):
    SKILLS_DIR.mkdir(parents=True, exist_ok=True)
    with open(REGISTRY_FILE, "w") as f:
        json.dump(registry, f, indent=2)

def discover_skills():
    registry = load_registry()
    changed = False
    
    for skill_dir in SKILLS_DIR.iterdir():
        if not skill_dir.is_dir() or skill_dir.name == ".git":
            continue
        
        manifest = skill_dir / "skill.json"
        if manifest.exists():
            if skill_dir.name not in registry["skills"]:
                try:
                    with open(manifest) as f:
                        info = json.load(f)
                    registry["skills"][skill_dir.name] = {
                        "name": info.get("name", skill_dir.name),
                        "version": info.get("version", "1.0.0"),
                        "description": info.get("description", ""),
                        "author": info.get("author", ""),
                        "commands": info.get("commands", {})
                    }
                    changed = True
                except Exception:
                    continue
    
    if changed:
        save_registry(registry)
    
    return registry

def cmd_list():
    print("=== 🔌 Skills instalados ===")
    registry = discover_skills()
    count = len(registry["skills"])
    
    if count == 0:
        print("   No hay skills instalados.")
        print("   Crea uno con: nexo-skill create <nombre>")
    else:
        for name, info in registry["skills"].items():
            print(f"  📦 {name} v{info['version']}")
            print(f"     {info['description']}")
            cmds = ", ".join(info.get("commands", {}).keys())
            print(f"     Comandos: {cmds}")
    
    print(f"\nTotal: {count} skills")

def cmd_info(name):
    if not name:
        print("Uso: nexo-skill info <nombre>")
        return 1
    
    registry = discover_skills()
    
    if name not in registry["skills"]:
        print(f"❌ Skill '{name}' no encontrado")
        return 1
    
    info = registry["skills"][name]
    print(f"=== 📦 {name} ===")
    print(f"Version: {info['version']}")
    print(f"Descripcion: {info['description']}")
    print(f"Autor: {info['author']}")
    print("\nComandos:")
    for cmd, cmd_info in info.get("commands", {}).items():
        print(f"  🔹 {cmd}: {cmd_info.get('description', '')}")
    
    return 0

def cmd_run(skill_name, cmd_name, *args):
    if not skill_name or not cmd_name:
        print("Uso: nexo-skill run <skill> <comando> [args...]")
        return 1
    
    manifest = SKILLS_DIR / skill_name / "skill.json"
    if not manifest.exists():
        print(f"❌ Skill '{skill_name}' no encontrado")
        return 1
    
    with open(manifest) as f:
        info = json.load(f)
    
    commands = info.get("commands", {})
    if cmd_name not in commands:
        print(f"❌ Comando '{cmd_name}' no encontrado en skill '{skill_name}'")
        print(f"   Comandos disponibles: {', '.join(commands.keys())}")
        return 1
    
    cmd_def = commands[cmd_name]
    exec_def = cmd_def.get("exec") or cmd_def.get("script", "")
    
    if not exec_def:
        print(f"❌ Comando '{cmd_name}' no tiene definición de ejecución")
        return 1
    
    skill_dir = SKILLS_DIR / skill_name
    exec_def = exec_def.replace("$SKILL_DIR", str(skill_dir)).replace("$HOME", str(Path.home()))
    
    # Ejecutar
    if exec_def.startswith("./scripts/"):
        script_path = skill_dir / exec_def[2:]
        os.execvp("bash", ["bash", str(script_path)] + list(args))
    else:
        import subprocess
        subprocess.run(exec_def + " " + " ".join(args), shell=True, cwd=skill_dir)
    
    return 0

def cmd_create(name):
    if not name:
        print("Uso: nexo-skill create <nombre>")
        return 1
    
    skill_dir = SKILLS_DIR / name
    if skill_dir.exists():
        print(f"❌ El skill '{name}' ya existe")
        return 1
    
    skill_dir.mkdir(parents=True)
    (skill_dir / "scripts").mkdir()
    
    # Crear manifest
    manifest = {
        "name": name,
        "version": "1.0.0",
        "description": f"Descripcion del skill {name}",
        "author": "Nexo",
        "commands": {
            "hola": {
                "description": "Comando de ejemplo",
                "exec": f'echo "Hola desde el skill {name}!"'
            },
            "fecha": {
                "description": "Muestra la fecha y hora",
                "exec": "echo \"Hoy es $(date)\""
            },
            "ejemplo": {
                "description": "Ejecuta script de ejemplo",
                "exec": "./scripts/ejemplo.sh"
            }
        }
    }
    
    with open(skill_dir / "skill.json", "w") as f:
        json.dump(manifest, f, indent=2)
    
    # Crear script de ejemplo
    script = skill_dir / "scripts" / "ejemplo.sh"
    script.write_text("""#!/bin/bash
echo "Este es un script de ejemplo del skill."
echo "Los scripts van en el directorio scripts/"
echo "Args recibidos: $@"""")
    script.chmod(0o755)
    
    print(f"✅ Skill '{name}' creado en {skill_dir}")
    print(f"   Editá skill.json para agregar comandos")
    print(f"   Probá: nexo-skill run {name} hola")
    
    return 0

def cmd_reload():
    print("♻️  Recargando skills...")
    discover_skills()
    print("✅ Skills recargados")
    cmd_list()
    return 0

def show_help():
    print("""╔══════════════════════════════════════╗
║    🔌 NEXO SKILL SYSTEM             ║
╠══════════════════════════════════════╣
║ Uso:                                ║
║  nexo-skill list         → Listar   ║
║  nexo-skill info <name>  → Info     ║
║  nexo-skill run <s> <c>  → Ejecutar ║
║  nexo-skill create <n>   → Crear    ║
║  nexo-skill reload       → Recargar ║
╚══════════════════════════════════════╝""")

def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "list"
    
    if cmd == "list":
        cmd_list()
        return 0
    elif cmd == "info":
        return cmd_info(args[1] if len(args) > 1 else "")
    elif cmd == "run":
        return cmd_run(args[1] if len(args) > 1 else "", 
                      args[2] if len(args) > 2 else "",
                      *args[3:])
    elif cmd == "create":
        return cmd_create(args[1] if len(args) > 1 else "")
    elif cmd == "reload":
        return cmd_reload()
    else:
        show_help()
        return 1

if __name__ == "__main__":
    sys.exit(main())
