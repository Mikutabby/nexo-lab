def cmd_embed(args):
    """Generar embedding para uno o todos los nodos.
    Uso: nexo-graph embed [id] | nexo-graph embed --all
    """
    store = GraphStore()
    if args and args[0] != "--all":
        # Embed un nodo específico
        nid = args[0]
        node = store.get_node(nid)
        if not node:
            print("❌ Nodo no encontrado")
            store.close()
            return
        print(f"🧠 Generando embedding para: {node['name']}...", end=" ", flush=True)
        if store.store_embedding(nid):
            print("✅ OK")
        else:
            print("❌ Falló (Ollama timeout, no disponible o contenido vacío)")
    else:
        # Embed todos los nodos sin embedding
        with store._lock:
            rows = store.conn.execute(
                """SELECT id, name FROM memory_nodes
                   WHERE (embedding IS NULL OR embedding = '')
                   AND id NOT IN ('root', 'user', 'directives', 'world')"""
            ).fetchall()
            nodes = [dict(r) for r in rows]
        if not nodes:
            print("🧠 Todos los nodos ya tienen embedding")
            store.close()
            return
        print(f"🧠 Generando embeddings para {len(nodes)} nodos...")
        success = 0
        for n in nodes:
            print(f"  • {n['name']}...", end=" ", flush=True)
            if store.store_embedding(n["id"]):
                print("✅")
                success += 1
            else:
                print("❌")
        print(f"✅ {success}/{len(nodes)} embeddings generados")
    store.close()


