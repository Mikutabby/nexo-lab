def cmd_migrate(args=None):
    """Migrar facts de memory.json al grafo."""
    if not MEMORY_JSON.exists():
        print("❌ No se encuentra memory.json")
        return

    with open(MEMORY_JSON) as f:
        data = json.load(f)

    store = GraphStore()
    migrated = 0

    # Migrar facts del usuario
    facts = data.get("user", {}).get("facts", [])
    for i, fact in enumerate(facts):
        existing = store.find_by_data_exact(fact, branch="user")
        if not existing:
            store.create_node(
                name=f"Fact {i+1}",
                data=fact,
                branch="user",
                description="Hecho sobre el usuario"
            )
            migrated += 1

    # Migrar preferencias
    prefs = data.get("user", {}).get("preferences", {})
    if prefs:
        prefs_text = "\n".join(f"{k}: {v}" for k, v in prefs.items())
        store.create_node(
            name="Preferencias del usuario",
            data=prefs_text,
            branch="user",
            description="Preferencias configuradas del usuario"
        )
        migrated += 1

    # Migrar mejoras como world
    improvements = data.get("learned_patterns", {}).get("improvements", [])
    if improvements:
        store.create_node(
            name="Mejoras del sistema",
            data="\n".join(improvements),
            branch="world",
            description="Mejoras implementadas en el sistema"
        )
        migrated += 1

    # Migrar dispositivos de red como world
    devices = data.get("network", {}).get("devices", {})
    if devices:
        device_texts = []
        for ip, info in devices.items():
            device_texts.append(f"{info.get('name', '?')} ({ip}): {info.get('notes', '')}")
        store.create_node(
            name="Dispositivos de red",
            data="\n".join(device_texts),
            branch="world",
            description="Dispositivos detectados en la red local"
        )
        migrated += 1

    # Migrar identidad como user
    nexo_info = data.get("nexo", {})
    if nexo_info:
        store.create_node(
            name="Identidad de Nexo",
            data=f"Nombre: {nexo_info.get('name', 'Nexo')}, Creador: {nexo_info.get('creator', 'mikuyasha')}, Ecosistema: {nexo_info.get('ecosystem', 'Nexo Ecosystem')}",
            branch="user",
            description="Información sobre la identidad del asistente"
        )
        migrated += 1

    # Migrar acciones pendientes
    pending = data.get("pending_actions", [])
    if pending:
        pend_texts = [f"{p.get('task', '?')}: {p.get('description', '')} [{p.get('status', 'pending')}]" for p in pending]
        store.create_node(
            name="Acciones pendientes",
            data="\n".join(pend_texts),
            branch="world",
            description="Tareas pendientes registradas"
        )
        migrated += 1

    store.close()
    print(f"✅ Migración completada: {migrated} nodos creados en el grafo")
    print("   Los datos originales en memory.json NO fueron modificados")


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    cmd = sys.argv[1]
    args = sys.argv[2:]

    commands = {
        "init": cmd_init,
        "add": cmd_add,
        "get": cmd_get,
        "search": cmd_search,
        "fts": cmd_fts,
        "recall": cmd_recall,
        "semsearch": cmd_semsearch,
        "embed": cmd_embed,
        "children": cmd_children,
        "warm-profile": cmd_warm_profile,
        "recent": cmd_recent,
        "top": cmd_top,
        "touch": cmd_touch,
        "stats": cmd_stats,
        "tree": cmd_tree,
        "migrate": cmd_migrate,
    }

    if cmd not in commands:
        print(f"❌ Comando desconocido: {cmd}")
        print(__doc__)
        sys.exit(1)

    commands[cmd](args)


if __name__ == "__main__":
    main()
