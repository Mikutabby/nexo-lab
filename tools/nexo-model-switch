#!/bin/bash
# nexo-model-switch — Auto model selector based on task intent
# Usage: nexo-model-switch "user message" [--apply]
#   --apply: actually changes opencode.json (default: just prints)

CONFIG_FILE="${OPENCODE_CONFIG:-$HOME/.opencode/opencode.jsonc}"
[ ! -f "$CONFIG_FILE" ] && CONFIG_FILE="$HOME/.opencode/opencode.json"
LOG_FILE="$HOME/.nexo-memory/log/model-switches.log"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Model definitions (ID | Provider | Cost | Best for)
declare -A MODELS
MODELS=(
  [mimo-v2.5-free]="opencode|free|multimodal,general,coding-basico,razonamiento"
  [deepseek-v4-flash-free]="opencode|free|rapido,general,coding"
  [nemotron-3-ultra-free]="opencode|free|coding-fuerte,agentic,conocimiento"
  [deepseek-v4-flash]="openrouter|$0.14/$0.28|rapido,volumen,coding"
  [deepseek-v4-pro]="openrouter|$1.74/$3.84|coding-fuerte,razonamiento"
  [claude-haiku-4-5]="openrouter|$0.80/$4|rapido,balanceado,coding"
  [claude-sonnet-4-6]="openrouter|$3/$15|coding-experto,razonamiento"
  [claude-opus-4-8]="openrouter|$5/$25|inteligente,razonamiento,coding-frontier"
  [gemini-3.5-flash]="openrouter|$1.50/$9|rapido,multimodal,largo-contexto"
  [gpt-5.4]="openrouter|$2.50/$15|general,coding,razonamiento"
  [gpt-5.4-mini]="openrouter|$0.75/$4|rapido,barato,coding"
  [gpt-5.4-nano]="openrouter|$0.20/$1.25|ultra-barato,uso-diario"
)

# Intent detection patterns (Spanish + English)
detect_intent() {
  local msg_lower=$(echo "$1" | tr '[:upper:]' '[:lower:]')
  
  # === HIGH POWER / INTELIGENCIA ===
  if echo "$msg_lower" | grep -qE '(potencia|poder|fuerte|inteligente|mejor|razona|piensa|analiza|complejo|difícil|complicado|avanzado|expert|powerful|smart|think|reason|analyze|complex|hard|advanced)'; then
    echo "power"
    return
  fi
  
  # === SERIOUS CODING ===
  if echo "$msg_lower" | grep -qE '(código serio|code serious|programa|desarrolla|implementa|debug|arregla|fix|compila|compile|error|bug|refactor|clase|función|api|endpoint|backend|frontend|fullstack|database|sql|git|deploy|docker|kubernetes)'; then
    echo "coding-serious"
    return
  fi
  
  # === FAST / QUICK ===
  if echo "$msg_lower" | grep -qE '(rápido|veloz|flash|pronto|apurate|dale masa|ya|now|fast|quick|hurry|speed)'; then
    echo "fast"
    return
  fi
  
  # === MULTIMODAL ===
  if echo "$msg_lower" | grep -qE '(imagen|image|foto|photo|video|audio|screenshot|diagrama|diagram|ver|look|observa|describe|multimodal)'; then
    echo "multimodal"
    return
  fi
  
  # === CHEAP / FREE ===
  if echo "$msg_lower" | grep -qE '(gratis|free|barato|cheap|sin pagar|no pago|económico)'; then
    echo "cheap"
    return
  fi
  
  # === LONG CONTEXT ===
  if echo "$msg_lower" | grep -qE '(archivo largo|large file|mucho texto|big document|libro|book|resumen|summary|resume|contexto largo|long context|todo el|el entero)'; then
    echo "long-context"
    return
  fi
  
  # === CREATIVE / WRITING ===
  if echo "$msg_lower" | grep -qE '(escribe|write|cuenta|story|historia|creative|creativo|redacta|draft|email|correo|carta|letter|articulo|article|blog)'; then
    echo "creative"
    return
  fi
  
  # === MATH / SCIENCE ===
  if echo "$msg_lower" | grep -qE '(matemática|math|cálculo|calculate|fórmula|formula|científico|science|física|physics|química|chemistry|estadística|statistics)'; then
    echo "math"
    return
  fi
  
  # === DEFAULT ===
  echo "default"
}

# Model selection based on intent
select_model() {
  local intent=$1
  
  case $intent in
    power)
      # Best reasoning, no cost concerns
      echo "claude-opus-4-8"
      ;;
    coding-serious)
      # Best coding, free first
      echo "nemotron-3-ultra-free"
      ;;
    fast)
      # Fastest, free first
      echo "deepseek-v4-flash-free"
      ;;
    multimodal)
      # Needs vision, free first
      echo "mimo-v2.5-free"
      ;;
    cheap)
      # Free models only
      echo "mimo-v2.5-free"
      ;;
    long-context)
      # 1M context needed
      echo "mimo-v2.5-free"
      ;;
    creative)
      # Good writing, balanced cost
      echo "claude-haiku-4-5"
      ;;
    math)
      # Strong reasoning
      echo "deepseek-v4-pro"
      ;;
    default)
      # Best free all-rounder
      echo "mimo-v2.5-free"
      ;;
  esac
}

# Get model info
get_model_info() {
  local model=$1
  local info="${MODELS[$model]:-unknown||}"
  IFS='|' read -r provider cost use_cases <<< "$info"
  echo "Provider: $provider | Cost: $cost | Use: $use_cases"
}

# Get current model
get_current_model() {
  python3 -c "
import json
with open('$CONFIG_FILE') as f:
    cfg = json.load(f)
print(cfg.get('model', 'unknown'))
" 2>/dev/null
}

# Apply model change
apply_model() {
  local new_model=$1
  local current_model=$(get_current_model)
  
  if [ "$current_model" = "$new_model" ]; then
    echo -e "${YELLOW}Already using: $new_model${NC}"
    return 0
  fi
  
  # Determine provider prefix
  local provider="openrouter"
  local info="${MODELS[$new_model]:-opencode||}"
  IFS='|' read -r prov cost uses <<< "$info"
  if [ "$prov" = "opencode" ]; then
    provider="opencode"
  fi
  
  local full_model="${provider}/${new_model}"
  
  # Update config
  python3 -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)
cfg['model'] = '$full_model'
with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
  
  # Log the switch
  mkdir -p "$(dirname "$LOG_FILE")"
  echo "$(date '+%Y-%m-%d %H:%M:%S') | $current_model → $full_model | intent: $DETECTED_INTENT" >> "$LOG_FILE"
  
  echo -e "${GREEN}✅ Switched: $current_model → $full_model${NC}"
}

# Main
MESSAGE="${1:-}"
APPLY=false

if [ "$2" = "--apply" ] || [ "$1" = "--apply" ]; then
  APPLY=true
  if [ "$2" = "--apply" ]; then
    MESSAGE="$1"
  else
    MESSAGE="$2"
  fi
fi

if [ -z "$MESSAGE" ]; then
  echo "Usage: nexo-model-switch \"user message\" [--apply]"
  echo ""
  echo "Options:"
  echo "  --apply    Actually change opencode.json (default: just prints)"
  echo ""
  echo "Examples:"
  echo '  nexo-model-switch "haceme un código serio de python"'
  echo '  nexo-model-switch "potencia total" --apply'
  echo '  nexo-model-switch "mirá esta imagen"'
  exit 0
fi

# Detect intent
DETECTED_INTENT=$(detect_intent "$MESSAGE")
SELECTED_MODEL=$(select_model "$DETECTED_INTENT")
CURRENT_MODEL=$(get_current_model)
MODEL_INFO=$(get_model_info "$SELECTED_MODEL")

echo -e "${CYAN}🔍 Intent detected: ${DETECTED_INTENT}${NC}"
echo -e "${CYAN}📊 Current model: ${CURRENT_MODEL}${NC}"
echo -e "${CYAN}🎯 Selected model: ${SELECTED_MODEL}${NC}"
echo -e "${CYAN}ℹ️  ${MODEL_INFO}${NC}"

if [ "$APPLY" = true ]; then
  apply_model "$SELECTED_MODEL"
else
  echo ""
  echo -e "${YELLOW}💡 Run with --apply to switch:${NC}"
  echo "   nexo-model-switch \"$MESSAGE\" --apply"
fi
