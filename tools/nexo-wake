#!/usr/bin/env python3
"""
🔊 Nexo Wake Word Detection v2
Escucha el micrófono, detecta la palabra "nexo" y captura comandos por voz.

Uso:
  nexo-wake                    → Modo loop infinito (bucle principal)
  nexo-wake once               → Escucha una vez, detecta "nexo"
  nexo-wake daemon start|stop  → Modo servicio en background
  nexo-wake sensitivity <0-1>  → Ajustar umbral fuzzy (defecto: 0.65)
"""

import difflib
import json
import logging
import os
import signal
import struct
import subprocess
import sys
import tempfile
import threading
import time
import wave
from pathlib import Path

# ── Configuración ──────────────────────────────────────────────────────────
SENSITIVITY = 0.65          # Umbral fuzzy match (0-1)
WAKE_DURATION = 3           # Segundos para detectar wake word
COMMAND_DURATION = 7        # Segundos para capturar comando después de wake
WAKE_WORDS = ["nexo", "neco", "nejo", "necho", "netsho", "necs", "neco", "nekso"]
VAD_AGGRESSIVENESS = 3      # 0=más permisivo, 3=más estricto
VAD_THRESHOLD = 15.0        # % mínimo de frames con voz para considerar "hay voz"
PULSE_SERVER = os.environ.get("PULSE_SERVER", "unix:/run/user/1000/pulse/native")
PIDFILE = "/tmp/nexo-wake.pid"
LOGFILE = "/tmp/nexo-wake.log"
LAST_TTS_FILE = "/tmp/nexo-last-tts.txt"
ECHO_JACCARD_THRESHOLD = 0.5

# ── Signal Handler (cleanup global) ───────────────────────────────────────

def _signal_handler(sig, frame):
    """Handler global: limpia procesos zombies y sale."""
    log.info(f"🛑 Señal {sig} recibida — limpiando procesos...")
    _cleanup_processes()
    # Matar cualquier ffmpeg zombie suelto
    _cleanup_ffmpeg_zombies()
    sys.exit(0)


signal.signal(signal.SIGTERM, _signal_handler)
signal.signal(signal.SIGINT, _signal_handler)

# ── Logging ────────────────────────────────────────────────────────────────
_quiet = False  # Modo silencioso (CLI commands like 'once')

class _CliFilter(logging.Filter):
    """Filtra logs en modo silencioso para CLI commands."""
    def filter(self, record):
        return not _quiet

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    handlers=[
        logging.FileHandler(LOGFILE),
        logging.StreamHandler(sys.stdout),
    ],
)
log = logging.getLogger("nexo-wake")
log.addFilter(_CliFilter())

def cli_print(msg):
    """Imprime un mensaje limpio al usuario (sin formato de log)."""
    print(msg, flush=True)

# ── VAD Utils (copied inline to avoid import path issues) ──────────────────
def has_speech(wav_path, aggressiveness=VAD_AGGRESSIVENESS, threshold=VAD_THRESHOLD):
    """Detecta si hay voz humana en un archivo WAV."""
    try:
        import webrtcvad
        with wave.open(wav_path, 'r') as wf:
            framerate = wf.getframerate()
            if framerate not in (8000, 16000, 32000, 48000):
                return True, 50.0
            pcm_data = wf.readframes(wf.getnframes())
            vad = webrtcvad.Vad(aggressiveness)
            frame_duration = 30
            frame_size = int(framerate * frame_duration / 1000) * 2
            speech_frames = 0
            total_frames = 0
            for i in range(0, len(pcm_data) - frame_size + 1, frame_size):
                frame = pcm_data[i:i + frame_size]
                if len(frame) < frame_size:
                    break
                try:
                    if vad.is_speech(frame, framerate):
                        speech_frames += 1
                    total_frames += 1
                except Exception:
                    pass
            if total_frames == 0:
                return False, 0.0
            pct = (speech_frames / total_frames) * 100
            return pct >= threshold, pct
    except Exception as e:
        log.warning(f"VAD error (asumiendo voz): {e}")
        return True, 50.0


# ── Process Tracking (para evitar zombies) ─────────────────────────────
_PROCESSES = []  # Lista de subprocesos lanzados
_PROCESSES_LOCK = threading.Lock()


def _track_process(proc):
    """Registra un subproceso para cleanup global."""
    with _PROCESSES_LOCK:
        _PROCESSES.append(proc)
    return proc


def _kill_process_group(proc, sig=signal.SIGTERM):
    """Mata un proceso y todo su grupo de procesos."""
    try:
        pgid = os.getpgid(proc.pid)
        if pgid:
            os.killpg(pgid, sig)
    except (ProcessLookupError, PermissionError, OSError):
        pass
    try:
        proc.kill()
    except Exception:
        pass


def _cleanup_processes():
    """Limpia TODOS los subprocesos tracked (usado en shutdown)."""
    with _PROCESSES_LOCK:
        for proc in _PROCESSES:
            if proc.poll() is None:  # Sigue vivo
                _kill_process_group(proc, signal.SIGKILL)
        _PROCESSES.clear()


def _cleanup_ffmpeg_zombies(tmpdir=None):
    """Mata ffmpeg zombies que referencien un directorio temporal específico."""
    import glob
    pattern = f"/tmp/nexo-wake-*/audio.wav"
    if tmpdir:
        pattern = os.path.join(tmpdir, "audio.wav")
    try:
        for wav in glob.glob(pattern):
            try:
                subprocess.run(
                    ["fuser", "-k", "-9", wav],
                    capture_output=True, timeout=5
                )
            except Exception:
                pass
    except Exception:
        pass


# ── Audio Recording ────────────────────────────────────────────────────────
def record_audio(duration, output_path):
    """
    Graba audio del micrófono usando parec (PulseAudio) o rec (SoX).
    Returns True si se grabó algo.
    AHORA con cleanup forzoso para evitar zombies ffmpeg.
    """
    os.environ["PULSE_SERVER"] = PULSE_SERVER

    # Método 1: parec + ffmpeg
    procs = []
    try:
        with open(output_path, 'wb') as f:
            proc1 = subprocess.Popen(
                ["parec", "--rate=16000", "--channels=1", "--format=s16le"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
            )
            _track_process(proc1)
            procs.append(proc1)

            proc2 = subprocess.Popen(
                ["ffmpeg", "-y", "-f", "s16le", "-ar", "16000", "-ac", "1",
                 "-i", "pipe:0", output_path],
                stdin=proc1.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
            _track_process(proc2)
            procs.append(proc2)

            proc1.stdout.close()

            # Esperar a que ffmpeg termine (con timeout)
            try:
                proc2.communicate(timeout=duration + 2)
            except subprocess.TimeoutExpired:
                log.warning("⏱️ ffmpeg timeout — matando...")
                _kill_process_group(proc2, signal.SIGKILL)
                proc2.communicate(timeout=3)

            # MATAR PRODUCTOR PRIMERO (parec), LUEGO VERIFICAR ffmpeg
            _kill_process_group(proc1, signal.SIGTERM)
            try:
                proc1.wait(timeout=3)
            except subprocess.TimeoutExpired:
                _kill_process_group(proc1, signal.SIGKILL)
                proc1.wait(timeout=2)

            # Verificar ffmpeg
            if proc2.poll() is None:
                _kill_process_group(proc2, signal.SIGKILL)
                proc2.wait(timeout=2)

        if os.path.getsize(output_path) > 1000:
            return True

    except Exception as e:
        log.debug(f"parec falló: {e}")
        # Asegurar cleanup
        for p in procs:
            if p.poll() is None:
                _kill_process_group(p, signal.SIGKILL)

    # Método 2: rec (SoX)
    try:
        proc_rec = subprocess.Popen(
            ["rec", "-q", "-r", "16000", "-c", "1", "-b", "16", output_path,
             "trim", "0", str(duration)],
            stderr=subprocess.DEVNULL
        )
        _track_process(proc_rec)
        try:
            proc_rec.wait(timeout=duration + 2)
        except subprocess.TimeoutExpired:
            _kill_process_group(proc_rec, signal.SIGKILL)
            proc_rec.wait(timeout=2)
        if os.path.getsize(output_path) > 1000:
            return True
    except Exception as e:
        log.debug(f"rec falló: {e}")

    # Método 3: arecord (ALSA)
    try:
        proc_arec = subprocess.Popen(
            ["arecord", "-q", "-r", "16000", "-c", "1", "-f", "S16_LE",
             "-d", str(duration), output_path],
            stderr=subprocess.DEVNULL
        )
        _track_process(proc_arec)
        try:
            proc_arec.wait(timeout=duration + 2)
        except subprocess.TimeoutExpired:
            _kill_process_group(proc_arec, signal.SIGKILL)
            proc_arec.wait(timeout=2)
        if os.path.getsize(output_path) > 1000:
            return True
    except Exception as e:
        log.debug(f"arecord falló: {e}")

    return False


# ── Speech-to-Text ─────────────────────────────────────────────────────────
def transcribe(wav_path, language="es-ES"):
    """Transcribe un archivo WAV usando Google STT."""
    try:
        import speech_recognition as sr
        r = sr.Recognizer()
        with sr.WavFile(wav_path) as source:
            r.adjust_for_ambient_noise(source, duration=0.3)
            audio = r.record(source)
        text = r.recognize_google(audio, language=language)
        return text.strip()
    except ImportError:
        # Intentar instalar
        try:
            subprocess.run(
                [sys.executable, "-m", "pip", "install",
                 "SpeechRecognition", "--break-system-packages"],
                timeout=30, stderr=subprocess.DEVNULL
            )
            import speech_recognition as sr
            r = sr.Recognizer()
            with sr.WavFile(wav_path) as source:
                r.adjust_for_ambient_noise(source, duration=0.3)
                audio = r.record(source)
            text = r.recognize_google(audio, language=language)
            return text.strip()
        except Exception:
            return None
    except sr.UnknownValueError:
        return None
    except sr.RequestError as e:
        log.warning(f"Google STT error: {e}")
        return None
    except Exception as e:
        log.debug(f"STT error: {e}")
        return None


# ── Wake Word Detection ────────────────────────────────────────────────────
def check_wake_word(text, sensitivity=SENSITIVITY):
    """
    Detecta si el texto contiene una variante de "nexo".
    Returns: (bool, word_matched, ratio)
    """
    if not text:
        return False, None, 0.0

    lower = text.lower()
    # Limpiar caracteres especiales
    clean = ''.join(c for c in lower if c.isalnum() or c.isspace())
    words = clean.split()

    best_match = None
    best_ratio = 0.0

    for word in words:
        for target in WAKE_WORDS:
            ratio = difflib.SequenceMatcher(None, word, target).ratio()
            if ratio > best_ratio:
                best_ratio = ratio
                best_match = (word, target)

    if best_ratio >= sensitivity:
        return True, best_match, best_ratio

    return False, None, best_ratio


# ── Echo Detection ─────────────────────────────────────────────────────────
def is_echo(text):
    """
    Detecta si el texto transcrito es un eco del último TTS hablado.
    Usa Jaccard similarity entre palabras.
    """
    if not os.path.exists(LAST_TTS_FILE):
        return False

    try:
        with open(LAST_TTS_FILE, 'r') as f:
            last_tts = f.read().strip().lower()
        if not last_tts:
            return False

        # Limpiar ambos textos
        import re
        def clean(t):
            return re.sub(r'[^a-záéíóúñ0-9 ]', '', t.lower()).split()

        last_words = set(clean(last_tts))
        text_words = set(clean(text))

        if not last_words or not text_words:
            return False

        intersection = last_words & text_words
        union = last_words | text_words
        jaccard = len(intersection) / len(union) if union else 0

        # Si más del threshold de palabras coinciden, es eco
        # O si el texto es muy corto (≤3 palabras) y 2+ coinciden
        if jaccard > ECHO_JACCARD_THRESHOLD:
            log.info(f"🔇 Eco detectado (Jaccard={jaccard:.2f}): ignorando")
            return True

        if len(text_words) <= 3 and len(intersection) >= 2:
            log.info(f"🔇 Eco detectado (texto corto, {len(intersection)} match): ignorando")
            return True

        return False
    except Exception:
        return False


# ── Core: record + detect ──────────────────────────────────────────────────
def record_and_check(duration=WAKE_DURATION):
    """
    Graba audio, VAD, transcribe y detecta wake word.
    Returns: (texto_transcrito, es_wake_word, match_info)
    """
    tmpdir = tempfile.mkdtemp(prefix="nexo-wake-")
    wav_path = os.path.join(tmpdir, "audio.wav")

    try:
        # Grabar
        ok = record_audio(duration, wav_path)
        if not ok:
            return None, False, None

        # VAD
        has_voice, pct = has_speech(wav_path)
        if not has_voice:
            log.debug(f"VAD: sin voz ({pct:.0f}%)")
            return None, False, None

        # Transcribir
        text = transcribe(wav_path)
        if not text:
            log.debug("STT: sin transcripción")
            return None, False, None

        log.info(f"📝 Transcripción: '{text}'")

        # Detectar eco
        if is_echo(text):
            return text, False, None

        # Detectar wake word
        is_wake, match, ratio = check_wake_word(text)

        return text, is_wake, match

    finally:
        # Matar zombies que usen este tmpdir ANTES de limpiar archivos
        _cleanup_ffmpeg_zombies(tmpdir)
        time.sleep(0.2)  # Dar tiempo a que los procesos mueran
        # Limpiar
        try:
            for f in os.listdir(tmpdir):
                os.remove(os.path.join(tmpdir, f))
            os.rmdir(tmpdir)
        except Exception:
            pass


def wait_for_command():
    """
    Después de detectar wake word, graba COMMAND_DURATION segundos
    y transcribe el comando completo.
    Returns: texto del comando o None
    """
    log.info(f"⏳ Escuchando comando ({COMMAND_DURATION}s)...")
    tmpdir = tempfile.mkdtemp(prefix="nexo-cmd-")
    wav_path = os.path.join(tmpdir, "cmd.wav")

    try:
        ok = record_audio(COMMAND_DURATION, wav_path)
        if not ok:
            log.info("⏹️  No se capturó audio para comando")
            return None

        has_voice, pct = has_speech(wav_path)
        if not has_voice:
            log.info(f"⏹️  Sin voz en comando ({pct:.0f}%)")
            return None

        text = transcribe(wav_path)
        if not text:
            log.info("⏹️  No se entendió el comando")
            return None

        log.info(f"🗣️  Comando: '{text}'")
        return text
    finally:
        # Matar zombies que usen este tmpdir ANTES de limpiar archivos
        _cleanup_ffmpeg_zombies(tmpdir)
        time.sleep(0.2)
        try:
            for f in os.listdir(tmpdir):
                os.remove(os.path.join(tmpdir, f))
            os.rmdir(tmpdir)
        except Exception:
            pass


# ── Modes ──────────────────────────────────────────────────────────────────

def cmd_once():
    """Escucha una vez y reporta."""
    global _quiet
    _quiet = True
    cli_print(f"🎤 Escuchando... ({WAKE_DURATION}s)")
    text, is_wake, match = record_and_check()
    _quiet = False

    if text:
        cli_print(f"📝 Transcripción: {text}")

    if is_wake:
        word, target = match if match else ("?", "?")
        cli_print(f"✅ Wake word detectada: '{word}'")
        return 0
    else:
        cli_print("❌ No se detectó wake word")
        return 1


def cmd_loop():
    """Bucle principal: escucha continuamente."""
    log.info(f"{'='*50}")
    log.info(f"🔊 Nexo Wake — Modo loop infinito")
    log.info(f"   Wake word: '{WAKE_WORDS[0]}' (variantes: {len(WAKE_WORDS)-1} más)")
    log.info(f"   Sensibilidad: {SENSITIVITY}")
    log.info(f"   Duración escucha: {WAKE_DURATION}s")
    log.info(f"   Duración comando: {COMMAND_DURATION}s")
    log.info(f"   Log: {LOGFILE}")
    log.info(f"{'='*50}")
    cli_print(f"🔊 Nexo Wake activo — decí 'Nexo' seguido de tu comando")
    cli_print(f"   Log: {LOGFILE}")

    consec_silence = 0

    while True:
        try:
            text, is_wake, match = record_and_check()

            if text and is_wake:
                word, target = match if match else ("?", "?")
                log.info(f"🔊 Wake: '{word}' (ratio={target}) → '{text}'")
                consec_silence = 0

                # Extraer comando después de "nexo"
                lower_text = text.lower()
                cmd_part = ""
                for w in WAKE_WORDS:
                    idx = lower_text.find(w)
                    if idx >= 0:
                        cmd_part = text[idx + len(w):].strip()
                        break

                if cmd_part:
                    log.info(f"📋 Comando inline: '{cmd_part}'")
                    # Aquí se podría ejecutar el comando directamente
                    print(f"⚡ Comando: {cmd_part}")
                else:
                    # Grabar comando completo
                    cmd_text = wait_for_command()
                    if cmd_text:
                        print(f"⚡ Comando: {cmd_text}")

            elif text and not is_wake:
                log.debug(f"🎤 (no wake) '{text}'")
                consec_silence = 0
            else:
                consec_silence += 1
                if consec_silence % 30 == 0:  # Reportar cada ~30 ciclos sin detección
                    log.debug(f"🔄 Escuchando... ({consec_silence} ciclos sin detección)")

            time.sleep(0.3)

        except KeyboardInterrupt:
            log.info("🛑 Nexo Wake detenido por el usuario")
            _cleanup_processes()
            _cleanup_ffmpeg_zombies()
            break
        except Exception as e:
            log.error(f"Error en loop: {e}")
            time.sleep(2)


def cmd_daemon(args):
    """Control de servicio en background."""
    action = args[0] if args else "start"

    if action == "start":
        if os.path.exists(PIDFILE):
            try:
                with open(PIDFILE) as f:
                    pid = int(f.read().strip())
                os.kill(pid, 0)
                log.error(f"❌ Ya está corriendo (PID: {pid})")
                return 1
            except (ProcessLookupError, ValueError):
                os.remove(PIDFILE)

        pid = os.fork()
        if pid > 0:
            # Padre: guardar PID del hijo y salir
            with open(PIDFILE, 'w') as f:
                f.write(str(pid))
            cli_print(f"✅ Nexo Wake daemon iniciado (PID: {pid})")
            return 0

        # Hijo: desacoplar completamente
        os.setsid()                         # Nueva sesión, nuevo grupo
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
        # Redirigir stdin/stdout/stderr
        with open(os.devnull, 'r') as nul:
            os.dup2(nul.fileno(), 0)        # stdin → /dev/null
        sys.stdout = open(LOGFILE, 'a')
        sys.stderr = open(LOGFILE, 'a')
        cmd_loop()

    elif action == "stop":
        if not os.path.exists(PIDFILE):
            cli_print("❌ Nexo Wake no está corriendo")
            return 1
        try:
            with open(PIDFILE) as f:
                pid = int(f.read().strip())
            os.kill(pid, signal.SIGTERM)
            os.remove(PIDFILE)
            cli_print("✅ Nexo Wake daemon detenido")
        except ProcessLookupError:
            os.remove(PIDFILE)
            cli_print("✅ Nexo Wake detenido (PID no existía)")
        except Exception as e:
            cli_print(f"❌ Error al detener: {e}")
            return 1
        return 0

    elif action == "status":
        if os.path.exists(PIDFILE):
            try:
                with open(PIDFILE) as f:
                    pid = int(f.read().strip())
                os.kill(pid, 0)
                cli_print(f"🔊 Nexo Wake: activo (PID: {pid})")
                return 0
            except (ProcessLookupError, ValueError):
                os.remove(PIDFILE)
        cli_print("🔊 Nexo Wake: inactivo")
        return 1

    else:
        cli_print(f"❌ Acción desconocida: {action}. Usar: start|stop|status")
        return 1


def cmd_sensitivity(args):
    """Ajustar o mostrar sensibilidad."""
    global SENSITIVITY
    global _quiet
    _quiet = True
    if args:
        try:
            val = float(args[0])
            if 0 <= val <= 1:
                SENSITIVITY = val
                cli_print(f"✅ Sensibilidad ajustada a: {SENSITIVITY}")
            else:
                cli_print("❌ Debe ser entre 0 y 1")
        except ValueError:
            cli_print("❌ Debe ser un número entre 0 y 1")
    else:
        cli_print(f"Sensibilidad actual: {SENSITIVITY}")
    _quiet = False


# ── Main ───────────────────────────────────────────────────────────────────
def main():
    if len(sys.argv) < 2:
        cmd_loop()
        return

    command = sys.argv[1]
    args = sys.argv[2:]

    if command in ("once", "one-shot"):
        sys.exit(cmd_once())
    elif command in ("loop", "listen", ""):
        cmd_loop()
    elif command == "daemon":
        sys.exit(cmd_daemon(args))
    elif command in ("sensitivity", "sens"):
        cmd_sensitivity(args)
    elif command in ("help", "--help", "-h"):
        print(__doc__)
    else:
        # Si no es un comando conocido, tratar como loop (comportamiento por defecto)
        cmd_loop()


if __name__ == "__main__":
    main()
