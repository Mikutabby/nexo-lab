#!/bin/bash
# nexo-auto-model — Automatic model detector and switcher
# Called by Nexo at the start of each response
# Usage: nexo-auto-model "user message"
# Output: JSON with intent, model, and whether to switch

CONFIG_FILE="${OPENCODE_CONFIG:-$HOME/.opencode/opencode.jsonc}"
[ ! -f "$CONFIG_FILE" ] && CONFIG_FILE="$HOME/.opencode/opencode.json"
LOG_FILE="$HOME/.nexo-memory/log/model-switches.log"

# Detect intent from message
detect_intent() {
  local msg=$(echo "$1" | tr '[:upper:]' '[:lower:]')
  
  # HIGH POWER / REASONING
  if echo "$msg" | grep -qE '(potencia|poder|fuerte|inteligente|mejor|razona|piensa|analiza|complejo|difícil|complicado|avanzado|expert|powerful|smart|think|reason|analyze|complex|hard|advanced|experto|profundo|deep)'; then
    echo "power"
    return
  fi
  
  # SERIOUS CODING
  if echo "$msg" | grep -qE '(código|code|programa|desarrolla|implementa|debug|arregla|fix|compila|compile|error|bug|refactor|clase|función|api|endpoint|backend|frontend|fullstack|database|sql|git|deploy|docker|script|automation|automatiz)'; then
    echo "coding"
    return
  fi
  
  # FAST / URGENT
  if echo "$msg" | grep -qE '(rápido|veloz|flash|pronto|apurate|dale masa|ya|now|fast|quick|hurry|speed|urgente|afanate)'; then
    echo "fast"
    return
  fi
  
  # MULTIMODAL (image, video, audio)
  if echo "$msg" | grep -qE '(imagen|image|foto|photo|video|audio|screenshot|diagrama|diagram|ver|look|observa|describe|multimodal|mirá|mira|mostrame|pantallazo)'; then
    echo "multimodal"
    return
  fi
  
  # CREATIVE / WRITING
  if echo "$msg" | grep -qE '(escribe|write|cuenta|story|historia|creative|creativo|redacta|draft|email|correo|carta|letter|articulo|article|blog|texto|text)'; then
    echo "creative"
    return
  fi
  
  # MATH / SCIENCE
  if echo "$msg" | grep -qE '(matemática|math|cálculo|calculate|fórmula|formula|científico|science|física|physics|química|chemistry|estadística|statistics|número|number)'; then
    echo "math"
    return
  fi
  
  # SYSTEM / ADMIN
  if echo "$msg" | grep -qE '(sistema|system|servidor|server|admin|configurar|config|instalar|install|limpiar|clean|monitorear|monitor|温度|temperature|procesos|process|disco|disk|ram|memoria)'; then
    echo "system"
    return
  fi
  
  # CONVERSATION / CASUAL
  if echo "$msg" | grep -qE '(hola|hey|qué tal|como andas|gracias|che|dale|bien|mal|genial|joya|perfecto|ok|bueno|chau|adiós)'; then
    echo "casual"
    return
  fi
  
  # LONG DOCUMENT / SUMMARY
  if echo "$msg" | grep -qE '(resumen|summary|resume|analizar.*documento|leer.*archivo|mucho texto|largo|large|big|entero|todo el)'; then
    echo "long-context"
    return
  fi
  
  echo "default"
}

# Select best model for intent
select_model() {
  local intent=$1
  
  case $intent in
    power)
      echo "opencode/claude-opus-4-8"
      ;;
    coding)
      echo "opencode/nemotron-3-ultra-free"
      ;;
    fast)
      echo "opencode/deepseek-v4-flash-free"
      ;;
    multimodal)
      echo "opencode/mimo-v2.5-free"
      ;;
    creative)
      echo "opencode/claude-haiku-4-5"
      ;;
    math)
      echo "opencode/deepseek-v4-pro"
      ;;
    system)
      echo "opencode/mimo-v2.5-free"
      ;;
    casual)
      echo "opencode/mimo-v2.5-free"
      ;;
    long-context)
      echo "opencode/mimo-v2.5-free"
      ;;
    default)
      echo "opencode/mimo-v2.5-free"
      ;;
  esac
}

# Get friendly name for model
model_name() {
  case $1 in
    *mimo*) echo "MiMo V2.5 (gratis, multimodal)" ;;
    *nemotron*) echo "Nemotron 3 Ultra (gratis, coding fuerte)" ;;
    *deepseek-v4-flash*) echo "DeepSeek V4 Flash (gratis, rápido)" ;;
    *deepseek-v4-pro*) echo "DeepSeek V4 Pro ($1.74/$3.84, razonamiento)" ;;
    *claude-opus*) echo "Claude Opus 4.8 ($5/$25, el más inteligente)" ;;
    *claude-haiku*) echo "Claude Haiku 4.5 ($0.80/$4, rápido + smart)" ;;
    *claude-sonnet*) echo "Claude Sonnet 4.6 ($3/$15, coding experto)" ;;
    *gemini*) echo "Gemini 3.5 Flash ($1.50/$9, Google multimodal)" ;;
    *gpt-5.4-mini*) echo "GPT-5.4 Mini ($0.75/$4, barato)" ;;
    *gpt-5.4-nano*) echo "GPT-5.4 Nano ($0.20/$1.25, ultra barato)" ;;
    *) echo "$1" ;;
  esac
}

# Get current model
get_current() {
  python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('model','?'))" 2>/dev/null
}

# Main
MESSAGE="${1:-}"

if [ -z "$MESSAGE" ]; then
  echo '{"error": "No message provided"}'
  exit 1
fi

CURRENT=$(get_current)
INTENT=$(detect_intent "$MESSAGE")
SUGGESTED=$(select_model "$INTENT")
FRIENDLY=$(model_name "$SUGGESTED")

# Check if switch needed
NEEDS_SWITCH=false
if [ "$CURRENT" != "$SUGGESTED" ]; then
  NEEDS_SWITCH=true
fi

# Output JSON
cat <<EOF
{
  "current_model": "$CURRENT",
  "intent": "$INTENT",
  "suggested_model": "$SUGGESTED",
  "friendly_name": "$FRIENDLY",
  "needs_switch": $NEEDS_SWITCH
}
EOF

# Log
mkdir -p "$(dirname "$LOG_FILE")"
echo "$(date '+%Y-%m-%d %H:%M:%S') | DETECT: $INTENT → $SUGGESTED (current: $CURRENT, switch: $NEEDS_SWITCH)" >> "$LOG_FILE"
