#!/bin/bash
# 🚀 Nexo Updater
# Actualiza Nexo Asistente desde el repositorio oficial.
#
# Uso:
#   nexo-update                     → Actualizar todo
#   nexo-update --check             → Verificar si hay actualización
#   nexo-update --force             → Reinstalar todo desde cero
#   nexo-update --version           → Mostrar versión
#   nexo-update --help              → Mostrar ayuda

set -euo pipefail

NEXO_VERSION="2.0"
REPO_URL="https://github.com/mikutabby/nexo-lab"
INSTALL_DIR="$HOME/.local/bin"
OPENCODE_DIR="$HOME/.opencode"
TMP_DIR="/tmp/nexo-update-$$"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
ok()   { echo -e "${GREEN}[OK]${NC} $1"; }
info() { echo -e "${BLUE}[i]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err()  { echo -e "${RED}[ERROR]${NC} $1"; }

show_help() {
  head -14 "$0" | grep -E "^# " | sed 's/^# //'
  exit 0
}

case "${1:-}" in
  --help|-h) show_help ;;
  --version|-v) echo "Nexo Updater v${NEXO_VERSION}"; exit 0 ;;
esac

# ─── Verificar dependencias ──────────────────────────────────────────────
for cmd in git curl cp chmod; do
  if ! command -v "$cmd" &>/dev/null; then
    err "Dependencia faltante: $cmd"
    exit 1
  fi
done

# ─── Check de versión remota ─────────────────────────────────────────────
check_update() {
  info "Verificando actualizaciones..."
  local remote_ver
  remote_ver=$(curl -sSL "${REPO_URL}/raw/main/tools/nexo-update" 2>/dev/null | \
    grep "NEXO_VERSION=" | head -1 | cut -d'"' -f2 || echo "")
  if [ -z "$remote_ver" ]; then
    warn "No se pudo verificar versión remota"
    return 1
  fi
  if [ "$remote_ver" != "$NEXO_VERSION" ]; then
    echo "  Local:  v${NEXO_VERSION}"
    echo "  Remote: v${remote_ver}"
    ok "Actualización disponible"
    return 0
  fi
  ok "Ya tenés la última versión (v${NEXO_VERSION})"
  return 1
}

if [ "${1:-}" = "--check" ]; then
  check_update
  exit $?
fi

# ─── Clonar repo temporal ────────────────────────────────────────────────
info "Descargando última versión..."
rm -rf "$TMP_DIR"
if ! git clone --depth 1 "$REPO_URL" "$TMP_DIR" 2>/dev/null; then
  err "No se pudo clonar el repositorio"
  err "Verificá: $REPO_URL"
  exit 1
fi

# ─── Forzar reinstalación completa ────────────────────────────────────────
if [ "${1:-}" = "--force" ]; then
  info "Reinstalación forzada..."
  bash "$TMP_DIR/install.sh"
  ok "Reinstalación completa"
  rm -rf "$TMP_DIR"
  exit 0
fi

# ─── Actualizar componentes ──────────────────────────────────────────────
UPDATED=0

update_file() {
  local src="$1" dst="$2"
  if [ ! -f "$src" ]; then
    return
  fi
  mkdir -p "$(dirname "$dst")"
  cp "$src" "$dst" && chmod +x "$dst"
  UPDATED=$((UPDATED + 1))
}

info "Actualizando scripts del sistema..."
mkdir -p "$INSTALL_DIR" "$OPENCODE_DIR"

for f in "$TMP_DIR"/core/identity/*.sh; do update_file "$f" "$INSTALL_DIR/$(basename "$f")"; done
for f in "$TMP_DIR"/core/monitor/*.sh; do update_file "$f" "$INSTALL_DIR/$(basename "$f")"; done
update_file "$TMP_DIR/core/system/limpiar" "$INSTALL_DIR/limpiar"
cp -r "$TMP_DIR/core/lib" "$INSTALL_DIR/lib" 2>/dev/null
update_file "$TMP_DIR/tools/nexo-diary" "$INSTALL_DIR/nexo-diary"
update_file "$TMP_DIR/tools/nexo-evaluate" "$INSTALL_DIR/nexo-evaluate"
update_file "$TMP_DIR/tools/nexo-tools" "$INSTALL_DIR/nexo-tools"
update_file "$TMP_DIR/tools/nexo-skill" "$INSTALL_DIR/nexo-skill"
update_file "$TMP_DIR/tools/nexo-wake" "$INSTALL_DIR/nexo-wake"
update_file "$TMP_DIR/tools/nexo-update" "$INSTALL_DIR/nexo-update"
update_file "$TMP_DIR/memory/nexo-graph" "$INSTALL_DIR/nexo-graph"
update_file "$TMP_DIR/memory/nexo-memory" "$INSTALL_DIR/nexo-memory"
update_file "$TMP_DIR/backup/nexo-backup.sh" "$INSTALL_DIR/nexo-backup.sh"
update_file "$TMP_DIR/backup/nexo-restore.sh" "$INSTALL_DIR/nexo-restore.sh"
update_file "$TMP_DIR/voice/say.sh" "$OPENCODE_DIR/say.sh"
update_file "$TMP_DIR/voice/voice.sh" "$OPENCODE_DIR/voice.sh"

rm -rf "$TMP_DIR"

# ─── Resumen ─────────────────────────────────────────────────────────────
if [ "$UPDATED" -gt 0 ]; then
  echo "2.0" > "$HOME/.nexo-version"
  ok "Actualización completada: $UPDATED archivos actualizados"
else
  warn "No se actualizó ningún archivo"
fi
