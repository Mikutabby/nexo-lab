#!/usr/bin/env python3
"""
nexo-update — Actualizador de Nexo
"""
import os
import sys
import subprocess
import shutil
import tempfile
from pathlib import Path

NEXO_VERSION = "2.0"
REPO_URL = "https://github.com/mikutabby/nexo-lab"
INSTALL_DIR = Path.home() / ".local" / "bin"
OPENCODE_DIR = Path.home() / ".opencode"

class Colors:
    RED = '\033[0;31m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    BLUE = '\033[0;34m'
    NC = '\033[0m'

def ok(msg): print(f"{Colors.GREEN}[OK]{Colors.NC} {msg}")
def info(msg): print(f"{Colors.BLUE}[i]{Colors.NC} {msg}")
def warn(msg): print(f"{Colors.YELLOW}[!]{Colors.NC} {msg}")
def err(msg): print(f"{Colors.RED}[ERROR]{Colors.NC} {msg}", file=sys.stderr)

def show_help():
    print(f"""🚀 Nexo Updater v{NEXO_VERSION}
Actualiza Nexo desde el repositorio oficial.

Uso:
  nexo-update                     → Actualizar todo
  nexo-update --check             → Verificar si hay actualización
  nexo-update --force             → Reinstalar todo desde cero
  nexo-update --version           → Mostrar versión
  nexo-update --help              → Mostrar ayuda""")

def check_update():
    info("Verificando actualizaciones...")
    try:
        result = subprocess.run(
            ["curl", "-sSL", f"{REPO_URL}/raw/main/tools/nexo-update"],
            capture_output=True, text=True
        )
        for line in result.stdout.split('\n'):
            if 'NEXO_VERSION=' in line:
                remote_ver = line.split('"')[1]
                if remote_ver != NEXO_VERSION:
                    print(f"  Local:  v{NEXO_VERSION}")
                    print(f"  Remote: v{remote_ver}")
                    ok("Actualización disponible")
                    return True
                else:
                    ok(f"Ya tenés la última versión (v{NEXO_VERSION})")
                    return False
    except Exception:
        warn("No se pudo verificar versión remota")
    return False

def update_file(src, dst):
    if not src.exists():
        return False
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
    dst.chmod(dst.stat().st_mode | 0o755)
    return True

def main():
    args = sys.argv[1:]
    
    if args[0] in ["--help", "-h"]:
        show_help()
        return 0
    
    if args[0] in ["--version", "-v"]:
        print(f"Nexo Updater v{NEXO_VERSION}")
        return 0
    
    if args[0] == "--check":
        return 0 if check_update() else 1
    
    # Verificar dependencias
    for cmd in ["git", "curl"]:
        if not shutil.which(cmd):
            err(f"Dependencia faltante: {cmd}")
            return 1
    
    # Clonar repo temporal
    info("Descargando última versión...")
    tmp_dir = tempfile.mkdtemp(prefix="nexo-update-")
    
    try:
        if subprocess.run(["git", "clone", "--depth", "1", REPO_URL, tmp_dir],
                         capture_output=True).returncode != 0:
            err("No se pudo clonar el repositorio")
            return 1
        
        # Forzar reinstalación
        if "--force" in args:
            info("Reinstalación forzada...")
            subprocess.run(["bash", str(Path(tmp_dir) / "install.sh")])
            ok("Reinstalación completa")
            return 0
        
        # Actualizar componentes
        updated = 0
        INSTALL_DIR.mkdir(parents=True, exist_ok=True)
        OPENCODE_DIR.mkdir(parents=True, exist_ok=True)
        
        tmp_path = Path(tmp_dir)
        
        # Actualizar scripts
        mappings = [
            ("core/identity/*.sh", INSTALL_DIR),
            ("core/monitor/*.sh", INSTALL_DIR),
        ]
        
        for pattern, dest_dir in mappings:
            for f in tmp_path.glob(pattern):
                if update_file(f, dest_dir / f.name):
                    updated += 1
        
        # Archivos específicos
        specific_files = [
            ("core/system/limpiar", "limpiar"),
            ("tools/nexo-diary", "nexo-diary"),
            ("tools/nexo-evaluate", "nexo-evaluate"),
            ("tools/nexo-tools", "nexo-tools"),
            ("tools/nexo-skill", "nexo-skill"),
            ("tools/nexo-wake", "nexo-wake"),
            ("tools/nexo-update", "nexo-update"),
            ("memory/nexo-graph", "nexo-graph"),
            ("memory/nexo-memory", "nexo-memory"),
            ("backup/nexo-backup.sh", "nexo-backup.sh"),
            ("backup/nexo-restore.sh", "nexo-restore.sh"),
        ]
        
        for src, dst in specific_files:
            if update_file(tmp_path / src, INSTALL_DIR / dst):
                updated += 1
        
        # Voz
        for src in ["voice/say.sh", "voice/voice.sh"]:
            if update_file(tmp_path / src, OPENCODE_DIR / src.split('/')[-1]):
                updated += 1
        
        # Librería
        lib_src = tmp_path / "core/lib"
        lib_dst = INSTALL_DIR / "lib"
        if lib_src.exists():
            shutil.copytree(lib_src, lib_dst, dirs_exist_ok=True)
        
        # Resumen
        if updated > 0:
            (Path.home() / ".nexo-version").write_text("2.0")
            ok(f"Actualización completada: {updated} archivos actualizados")
        else:
            warn("No se actualizó ningún archivo")
        
        return 0
    
    finally:
        shutil.rmtree(tmp_dir, ignore_errors=True)

if __name__ == "__main__":
    sys.exit(main())
