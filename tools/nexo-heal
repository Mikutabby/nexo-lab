#!/usr/bin/env python3
"""
nexo-heal — Sistema de auto-curación de Nexo
"""
import os
import sys
import subprocess
import hashlib
import sqlite3
import time
from pathlib import Path
from datetime import datetime

NEXO_VERSION = "2.0"
MEMORY_DIR = Path.home() / ".nexo-memory"
LOG_DIR = MEMORY_DIR / "log"
GRAPH_DB = MEMORY_DIR / "graph.db"
HEAL_LOG = LOG_DIR / "heal.log"

class Colors:
    RED = '\033[0;31m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    BLUE = '\033[0;34m'
    NC = '\033[0m'

def ok(msg): print(f"{Colors.GREEN}[OK]{Colors.NC} {msg}")
def info(msg): print(f"{Colors.BLUE}[i]{Colors.NC} {msg}")
def warn(msg): print(f"{Colors.YELLOW}[!]{Colors.NC} {msg}")
def err(msg): print(f"{Colors.RED}[ERROR]{Colors.NC} {msg}", file=sys.stderr)

def log_heal(msg):
    HEAL_LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(HEAL_LOG, "a") as f:
        f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n")

def run_cmd(cmd, check=False):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True)

def hash_text(text):
    return hashlib.sha256(text.encode()).hexdigest()[:16]

KNOWN_FIXES = [
    ("ollama:Connection refused", "ollama serve >/dev/null 2>&1 &"),
    ("ollama:not found", "curl -fsSL https://ollama.com/install.sh | sh"),
    ("Permission denied", "chmod +x"),
    ("gpg:command not found", "sudo apt install -y gpg 2>/dev/null || sudo pacman -S --noconfirm gnupg"),
    ("pip3:command not found", "sudo apt install -y python3-pip 2>/dev/null || sudo pacman -S --noconfirm python-pip"),
    ("espeak-ng:command not found", "sudo apt install -y espeak-ng 2>/dev/null || sudo pacman -S --noconfirm espeak-ng"),
]

def scan_logs():
    info("Escaneando logs de Nexo en busca de errores...")
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    found = 0
    
    for logfile in LOG_DIR.glob("*.log"):
        if not logfile.exists():
            continue
        
        try:
            content = logfile.read_text()
            errors = [line for line in content.split('\n') 
                     if any(kw in line.lower() for kw in ['error', 'fail', 'fatal', 'exception'])]
            
            for line in errors[-20:]:
                error_key = hash_text(line)
                exists = run_cmd(f"nexo-graph search err:{error_key}").returncode == 0
                
                if not exists and error_key not in str(run_cmd("nexo-graph search err:").stdout):
                    run_cmd(f'nexo-memory save error "{logfile.name}: {line[:100]}"')
                    run_cmd(f'nexo-graph add world "err:{error_key}" "source:{logfile.name}|{line[:200]}"')
                    info(f"  Nuevo error: {logfile.name} → {line[:80]}")
                    found += 1
        except Exception:
            continue
    
    if found == 0:
        ok("No se encontraron errores nuevos")
    else:
        warn(f"Se encontraron {found} errores nuevos. Ejecutá: nexo-heal fix")
    
    log_heal(f"scan: {found} errores nuevos")
    return found

def find_fix(error_text):
    # Buscar en KNOWN_FIXES
    for pattern, cmd in KNOWN_FIXES:
        if pattern.lower() in error_text.lower():
            return cmd
    
    # Buscar en knowledge graph
    if GRAPH_DB.exists():
        try:
            result = run_cmd(f"nexo-graph search fix:")
            if result.returncode == 0:
                for line in result.stdout.split('\n'):
                    if 'fix:' in line:
                        node_id = line.split('id:')[1].split()[0] if 'id:' in line else None
                        if node_id:
                            data = run_cmd(f"nexo-graph get {node_id}")
                            if 'Datos:' in data.stdout:
                                return data.stdout.split('Datos:')[1].strip()
        except Exception:
            pass
    
    return None

def apply_fix(error_text):
    fix_cmd = find_fix(error_text)
    if not fix_cmd:
        return 1
    
    info(f"  Aplicando fix: {fix_cmd}")
    log_heal(f"apply: {fix_cmd}")
    
    if run_cmd(fix_cmd).returncode == 0:
        ok("  Fix aplicado exitosamente")
        log_heal(f"success: {fix_cmd}")
        return 0
    else:
        warn("  Fix falló")
        log_heal(f"failed: {fix_cmd}")
        return 2

def cmd_fix():
    info("Buscando fixes para errores conocidos...")
    fixed = failed = unknown = 0
    
    # Obtener errores del knowledge graph
    result = run_cmd("nexo-graph search err:")
    errors = [line for line in result.stdout.split('\n') if 'err:' in line][:20]
    
    if not errors:
        info("No hay errores registrados. Ejecutá: nexo-heal scan")
        return
    
    for line in errors:
        if not line.strip():
            continue
        
        info(f"Procesando: {line[:80]}")
        status = apply_fix(line)
        
        if status == 0:
            fixed += 1
            fix_cmd = find_fix(line)
            if fix_cmd:
                fix_hash = hash_text(line)
                run_cmd(f'nexo-graph add world "fix:{fix_hash}" "{fix_cmd}"')
                run_cmd(f'nexo-memory save improvement "Auto-fix: {fix_cmd}"')
        elif status == 2:
            failed += 1
        else:
            unknown += 1
    
    print()
    if fixed > 0:
        ok(f"{fixed} error(es) corregidos")
    if failed > 0:
        warn(f"{failed} fix(es) fallaron")
    if unknown > 0:
        warn(f"{unknown} error(es) sin fix conocido")
    
    log_heal(f"fix: {fixed} fixed, {failed} failed, {unknown} unknown")

def cmd_learn(error_text, fix_command):
    if not error_text or not fix_command:
        err("Uso: nexo-heal learn <error> <fix>")
        err("Ejemplo: nexo-heal learn 'ollama: connection refused' 'ollama serve &'")
        return 1
    
    fix_hash = hash_text(error_text)
    run_cmd(f'nexo-graph add world "fix:{fix_hash}" "{fix_command}"')
    run_cmd(f'nexo-memory save improvement "Aprendido: {error_text} → {fix_command}"')
    ok(f"Fix aprendido: {error_text} → {fix_command}")
    log_heal(f"learn: {error_text} → {fix_command}")
    return 0

def cmd_watch(interval=60):
    info(f"Modo watch: monitoreando cada {interval}s...")
    
    pid_file = Path("/tmp/nexo-heal.pid")
    pid_file.write_text(str(os.getpid()))
    
    try:
        while True:
            try:
                scan_logs()
                cmd_fix()
            except Exception:
                pass
            time.sleep(interval)
    except KeyboardInterrupt:
        pid_file.unlink(missing_ok=True)

def cmd_status():
    print("🩺 Nexo Self-Healing System")
    print("=" * 30)
    
    result = run_cmd("nexo-memory status")
    error_count = 0
    improvement_count = 0
    
    if result.returncode == 0:
        for line in result.stdout.split('\n'):
            if 'Errores' in line:
                error_count = int(''.join(filter(str.isdigit, line)) or 0)
            elif 'Mejoras' in line:
                improvement_count = int(''.join(filter(str.isdigit, line)) or 0)
    
    print(f"Errores registrados: {error_count}")
    
    fix_result = run_cmd("nexo-graph search fix:")
    fix_count = fix_result.stdout.count('fix:') if fix_result.returncode == 0 else 0
    print(f"Fixes conocidos: {fix_count}")
    print(f"Mejoras aplicadas: {improvement_count}")
    
    if HEAL_LOG.exists():
        print("\nÚltimas recuperaciones:")
        lines = HEAL_LOG.read_text().strip().split('\n')[-5:]
        for line in lines:
            if line.strip():
                print(f"  {line}")
    
    print()
    pid_file = Path("/tmp/nexo-heal.pid")
    if pid_file.exists():
        try:
            pid = int(pid_file.read_text())
            os.kill(pid, 0)
            ok(f"Watch mode activo (PID: {pid})")
        except:
            info("Watch mode: inactivo")
    else:
        info("Watch mode: inactivo")

def show_help():
    print(f"""🩺 Nexo Self-Healing System v{NEXO_VERSION}
Detecta errores en scripts de Nexo y busca soluciones.

Uso:
  nexo-heal scan              Escanear logs en busca de errores
  nexo-heal fix               Intentar arreglar errores conocidos
  nexo-heal learn <error> <fix>  Enseñar un nuevo fix
  nexo-heal auto              scan + fix (full cycle)
  nexo-heal watch [segundos]  Modo daemon (default: 60s)
  nexo-heal status            Mostrar estadísticas de salud""")

def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "help"
    
    if cmd in ["--help", "-h"]:
        show_help()
        return 0
    elif cmd in ["--version", "-v"]:
        print(f"Nexo Heal v{NEXO_VERSION}")
        return 0
    elif cmd == "scan":
        return scan_logs()
    elif cmd == "fix":
        cmd_fix()
        return 0
    elif cmd == "learn":
        return cmd_learn(args[1] if len(args) > 1 else "", args[2] if len(args) > 2 else "")
    elif cmd == "auto":
        scan_logs()
        cmd_fix()
        ok("Auto-healing cycle completado")
        return 0
    elif cmd == "watch":
        interval = int(args[1]) if len(args) > 1 else 60
        cmd_watch(interval)
        return 0
    elif cmd in ["status", "health"]:
        cmd_status()
        return 0
    else:
        err(f"Comando desconocido: {cmd}")
        show_help()
        return 1

if __name__ == "__main__":
    sys.exit(main())
