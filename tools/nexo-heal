#!/bin/bash
# 🩺 Nexo Self-Healing System
# Detecta errores en los propios scripts de Nexo, busca soluciones
# conocidas, las aplica, y aprende de la experiencia.
#
# Uso:
#   nexo-heal scan              → Escanear logs en busca de errores
#   nexo-heal fix               → Intentar arreglar errores conocidos
#   nexo-heal learn <error> <fix>  → Enseñar un nuevo fix
#   nexo-heal auto              → scan + fix + learn (full cycle)
#   nexo-heal watch             → Modo daemon (monitoreo continuo)
#   nexo-heal status            → Mostrar estadísticas de salud
#   nexo-heal --help            → Mostrar ayuda
#
# Integración con nexo-memory:
#   Los errores se guardan con: nexo-memory save error "..."
#   Los fixes se guardan en el knowledge graph bajo "world" con prefijo "fix:"
#   Cada fix resuelto se registra como mejora: nexo-memory save improvement "..."

set -euo pipefail

NEXO_VERSION="2.0"
MEMORY_DIR="$HOME/.nexo-memory"
LOG_DIR="$MEMORY_DIR/log"
GRAPH_DB="$MEMORY_DIR/graph.db"
LEARN_DIR="$MEMORY_DIR/learned"
HEAL_LOG="$LOG_DIR/heal.log"
NEXO_GRAPH="${NEXO_GRAPH:-nexo-graph}"
NEXO_MEMORY="${NEXO_MEMORY:-nexo-memory}"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'
ok()   { echo -e "${GREEN}[OK]${NC} $1"; }
info() { echo -e "${BLUE}[i]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err()  { echo -e "${RED}[ERROR]${NC} $1"; }

show_help() {
  head -22 "$0" | grep -E "^# " | sed 's/^# //'
  exit 0
}

log_heal() {
  mkdir -p "$(dirname "$HEAL_LOG")"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$HEAL_LOG"
}

# ─── Detectar errores en logs de Nexo ──────────────────────────────────
scan_logs() {
  info "Escaneando logs de Nexo en busca de errores..."
  mkdir -p "$LOG_DIR"
  local found=0

  local logfiles
  logfiles=$(find "$LOG_DIR" /tmp -maxdepth 1 -name '*.log' -type f 2>/dev/null) || true
  while IFS= read -r logfile; do
    [ -f "$logfile" ] || continue
    local errors
    errors=$(grep -i "error\|fail\|fatal\|traceback\|exception\|core dumped\|segmentation fault" "$logfile" 2>/dev/null | tail -20) || true
    if [ -n "$errors" ]; then
      local basename
      basename=$(basename "$logfile")
      while IFS= read -r line; do
        [ -z "$line" ] && continue
        local error_key
        error_key=$(echo "$line" | sha256sum | cut -c1-16)
        local exists
        exists=$($NEXO_GRAPH search "err:$error_key" 2>/dev/null | grep -c "err:$error_key" || true)
        if [ "$exists" -eq 0 ]; then
          $NEXO_MEMORY save error "$basename: $line" 2>/dev/null
          $NEXO_GRAPH add world "err:$error_key" "source:$basename|$line" 2>/dev/null
          info "  Nuevo error: $basename → ${line:0:80}"
          found=$((found + 1))
        fi
      done <<< "$errors"
    fi
  done

  if [ "$found" -eq 0 ]; then
    ok "No se encontraron errores nuevos"
  else
    warn "Se encontraron $found errores nuevos. Ejecutá: nexo-heal fix"
  fi
  log_heal "scan: $found errores nuevos"
  return "$found"
}

# ─── Fixes conocidos (hardcoded) ───────────────────────────────────────
KNOWN_FIXES=(
  "ollama:Connection refused|ollama serve >/dev/null 2>&1 &"
  "ollama:not found|curl -fsSL https://ollama.com/install.sh | sh"
  "nexo-graph:No such file|ln -sf $HOME/.local/bin/nexo-graph $HOME/.local/bin/nexo-graph 2>/dev/null; chmod +x $HOME/.local/bin/nexo-graph"
  "nexo-memory:command not found|ln -sf $HOME/.local/bin/nexo-memory . 2>/dev/null"
  "Permission denied|chmod +x"
  "gpg:command not found|sudo apt install -y gpg 2>/dev/null || sudo pacman -S --noconfirm gnupg 2>/dev/null"
  "pip3:command not found|sudo apt install -y python3-pip 2>/dev/null || sudo pacman -S --noconfirm python-pip 2>/dev/null"
  "speech_recognition:ModuleNotFoundError|pip3 install --break-system-packages SpeechRecognition 2>/dev/null || pip3 install SpeechRecognition 2>/dev/null"
  "gtts:ModuleNotFoundError|pip3 install --break-system-packages gtts 2>/dev/null || pip3 install gtts 2>/dev/null"
  "piper:not found|wget -q https://github.com/rhasspy/piper/releases/latest/download/piper_linux_x86_64.tar.gz -O /tmp/piper.tar.gz && tar xzf /tmp/piper.tar.gz -C $HOME/.local/bin/ && rm /tmp/piper.tar.gz"
  "flock:command not found|sudo apt install -y util-linux 2>/dev/null || true"
  "sensors:command not found|sudo apt install -y lm-sensors 2>/dev/null || sudo pacman -S --noconfirm lm_sensors 2>/dev/null"
  "espeak-ng:command not found|sudo apt install -y espeak-ng 2>/dev/null || sudo pacman -S --noconfirm espeak-ng 2>/dev/null"
)

# ─── Buscar fix en knowledge graph o en known_fixes ──────────────────────
find_fix() {
  local error_text="$1"
  local fix_cmd=""

  # Buscar en KNOWN_FIXES
  for entry in "${KNOWN_FIXES[@]}"; do
    local pattern="${entry%%|*}"
    local cmd="${entry#*|}"
    if echo "$error_text" | grep -qi "$pattern"; then
      fix_cmd="$cmd"
      break
    fi
  done

  # Buscar en knowledge graph
  if [ -z "$fix_cmd" ] && [ -f "$GRAPH_DB" ]; then
    local graph_fix
    graph_fix=$($NEXO_GRAPH search "fix:" 2>/dev/null | grep -i "$(echo "$error_text" | cut -c1-40)" | head -1) || true
    if [ -n "$graph_fix" ]; then
      local node_id
      node_id=$(echo "$graph_fix" | grep -oP 'id: \K[^ ]+' || true)
      if [ -n "$node_id" ]; then
        local node_data
        node_data=$($NEXO_GRAPH get "$node_id" 2>/dev/null) || true
        fix_cmd=$(echo "$node_data" | grep "^   Datos:" | sed 's/^   Datos://' || true)
      fi
    fi
  fi

  echo "$fix_cmd"
}

# ─── Intentar aplicar fixes ────────────────────────────────────────────
apply_fix() {
  local error_text="$1"
  local fix_cmd
  fix_cmd=$(find_fix "$error_text")

  if [ -z "$fix_cmd" ]; then
    return 1
  fi

  info "  Aplicando fix: $fix_cmd"
  log_heal "apply: $fix_cmd"
  if eval "$fix_cmd" 2>/dev/null; then
    ok "  Fix aplicado exitosamente"
    log_heal "success: $fix_cmd"
    return 0
  else
    warn "  Fix falló"
    log_heal "failed: $fix_cmd"
    return 2
  fi
}

# ─── Fix mode ──────────────────────────────────────────────────────────
cmd_fix() {
  info "Buscando fixes para errores conocidos..."
  local fixed=0
  local unknown=0
  local failed=0

  # Obtener errores desde el knowledge graph
  local errors
  errors=$($NEXO_GRAPH search "err:" 2>/dev/null | grep "err:" | head -20) || true
  if [ -z "$errors" ]; then
    # Fallback: buscar en memory.json
    local error_count
    error_count=$($NEXO_MEMORY status 2>/dev/null | grep "Errores" | grep -oP '\d+') || true
    if [ "${error_count:-0}" -eq 0 ]; then
      info "No hay errores registrados. Ejecutá: nexo-heal scan"
      return 0
    fi
  fi

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    info "Procesando: ${line:0:80}"
    if apply_fix "$line"; then
      fixed=$((fixed + 1))
      # Registrar fix en knowledge graph para aprendizaje futuro
      local fix_cmd
      fix_cmd=$(find_fix "$line")
      if [ -n "$fix_cmd" ]; then
        local fix_hash
        fix_hash=$(echo "$line" | sha256sum | cut -c1-16)
        $NEXO_GRAPH add world "fix:$fix_hash" "$fix_cmd" 2>/dev/null
        $NEXO_MEMORY save improvement "Auto-fix: $fix_cmd" 2>/dev/null
      fi
    elif [ $? -eq 2 ]; then
      failed=$((failed + 1))
    else
      unknown=$((unknown + 1))
    fi
  done <<< "$errors"

  echo ""
  if [ "$fixed" -gt 0 ]; then ok "$fixed error(es) corregidos"; fi
  if [ "$failed" -gt 0 ]; then warn "$failed fix(es) fallaron"; fi
  if [ "$unknown" -gt 0 ]; then warn "$unknown error(es) sin fix conocido"; fi

  log_heal "fix: $fixed fixed, $failed failed, $unknown unknown"
}

# ─── Learn mode ────────────────────────────────────────────────────────
cmd_learn() {
  local error_text="${1:-}"
  local fix_command="${2:-}"
  if [ -z "$error_text" ] || [ -z "$fix_command" ]; then
    err "Uso: nexo-heal learn <error> <fix>"
    err "Ejemplo: nexo-heal learn 'ollama: connection refused' 'ollama serve &'"
    exit 1
  fi

  local fix_hash
  fix_hash=$(echo "$error_text" | sha256sum | cut -c1-16)
  $NEXO_GRAPH add world "fix:$fix_hash" "$fix_command" 2>/dev/null
  $NEXO_MEMORY save improvement "Aprendido: $error_text → $fix_command" 2>/dev/null
  ok "Fix aprendido: $error_text → $fix_command"
  log_heal "learn: $error_text → $fix_command"
}

# ─── Watch mode (daemon) ──────────────────────────────────────────────
cmd_watch() {
  local interval="${1:-60}"
  info "Modo watch: monitoreando cada ${interval}s..."
  info "Para detener: kill $PPID 2>/dev/null || true"

  local pid_file="/tmp/nexo-heal.pid"
  echo "$$" > "$pid_file"

  while true; do
    scan_logs > /dev/null 2>&1 || true
    cmd_fix > /dev/null 2>&1 || true
    sleep "$interval"
  done
}

# ─── Status ────────────────────────────────────────────────────────────
cmd_status() {
  echo "🩺 Nexo Self-Healing System"
  echo "==========================="
  echo ""

  local error_count
  error_count=$($NEXO_MEMORY status 2>/dev/null | grep "Errores" | grep -oP '\d+' || echo 0)
  echo "Errores registrados: $error_count"

  local fix_count
  fix_count=$($NEXO_GRAPH search "fix:" 2>/dev/null | grep -c "fix:" || echo 0)
  echo "Fixes conocidos: $fix_count"

  local improvement_count
  improvement_count=$($NEXO_MEMORY status 2>/dev/null | grep "Mejoras" | grep -oP '\d+' || echo 0)
  echo "Mejoras aplicadas: $improvement_count"

  echo ""
  if [ -f "$HEAL_LOG" ]; then
    echo "Últimas recuperaciones:"
    tail -5 "$HEAL_LOG" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
  fi

  echo ""
  if [ -f "/tmp/nexo-heal.pid" ] && kill -0 "$(cat /tmp/nexo-heal.pid)" 2>/dev/null; then
    ok "Watch mode activo (PID: $(cat /tmp/nexo-heal.pid))"
  else
    info "Watch mode: inactivo"
  fi
}

# ─── Main ──────────────────────────────────────────────────────────────
case "${1:-}" in
  --help|-h) show_help ;;
  --version|-v) echo "Nexo Heal v${NEXO_VERSION}"; exit 0 ;;
  scan) scan_logs ;;
  fix) cmd_fix ;;
  learn) shift; cmd_learn "$@" ;;
  auto)
    scan_logs
    cmd_fix
    ok "Auto-healing cycle completado"
    ;;
  watch) cmd_watch "${2:-60}" ;;
  status|health) cmd_status ;;
  *)
    err "Comando desconocido: ${1:-}"
    show_help
    exit 1
    ;;
esac
