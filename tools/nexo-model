#!/bin/bash
# nexo-model — Quick model switcher with shortcuts
# Usage: nexo-model <command>
#
# Commands:
#   status          Show current model and available models
#   default         Switch to default (mimo-v2.5-free)
#   potencia        Switch to most powerful (claude-opus-4-8)
#   codigo          Switch to coding expert (nemotron-3-ultra-free)
#   rapido          Switch to fastest (deepseek-v4-flash-free)
#   barato          Switch to cheapest (mimo-v2.5-free)
#   smart           Switch to smart & cheap (claude-haiku-4-5)
#   switch "msg"    Auto-detect and switch
#   log             Show recent model switches
#   restore         Restore last model

CONFIG_FILE="${OPENCODE_CONFIG:-$HOME/.opencode/opencode.jsonc}"
[ ! -f "$CONFIG_FILE" ] && CONFIG_FILE="$HOME/.opencode/opencode.json"
LOG_FILE="$HOME/.nexo-memory/log/model-switches.log"
LAST_MODEL_FILE="/tmp/nexo-last-model"

# Colors
G='\033[0;32m'
Y='\033[1;33m'
C='\033[0;36m'
B='\033[1;34m'
NC='\033[0m'

get_current() {
  python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('model','?'))" 2>/dev/null
}

set_model() {
  local model=$1
  local current=$(get_current)
  
  # Save last model for restore
  echo "$current" > "$LAST_MODEL_FILE"
  
  python3 -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)
cfg['model'] = '$model'
with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
  
  # Log
  mkdir -p "$(dirname "$LOG_FILE")"
  echo "$(date '+%Y-%m-%d %H:%M:%S') | $current → $model" >> "$LOG_FILE"
  
  echo -e "${G}✅ $current → $model${NC}"
}

show_status() {
  local current=$(get_current)
  echo -e "${B}═══════════════════════════════════════${NC}"
  echo -e "${B}  🤖 NEXO MODEL STATUS${NC}"
  echo -e "${B}═══════════════════════════════════════${NC}"
  echo ""
  echo -e "  ${C}Current model:${NC} $current"
  echo ""
  echo -e "  ${Y}Available shortcuts:${NC}"
  echo -e "  ${G}default${NC}  → mimo-v2.5-free      (gratis, multimodal)"
  echo -e "  ${G}potencia${NC} → claude-opus-4-8     (\$5/\$25, el más inteligente)"
  echo -e "  ${G}codigo${NC}   → nemotron-3-ultra-free (gratis, coding fuerte)"
  echo -e "  ${G}rapido${NC}   → deepseek-v4-flash-free (gratis, el más rápido)"
  echo -e "  ${G}barato${NC}   → mimo-v2.5-free      (gratis, todo bien)"
  echo -e "  ${G}smart${NC}    → claude-haiku-4-5     (\$0.80/\$4, rápido + inteligente)"
  echo -e "  ${G}restore${NC}  → vuelve al modelo anterior"
  echo ""
  echo -e "  ${Y}Usage:${NC}"
  echo -e "  nexo-model potencia"
  echo -e "  nexo-model switch \"código serio de python\""
  echo ""
  echo -e "${B}═══════════════════════════════════════${NC}"
}

show_log() {
  if [ -f "$LOG_FILE" ]; then
    echo -e "${B}Recent model switches:${NC}"
    tail -10 "$LOG_FILE"
  else
    echo "No switches logged yet."
  fi
}

# Main
case "${1:-status}" in
  status|s)
    show_status
    ;;
  default|d)
    set_model "opencode/mimo-v2.5-free"
    ;;
  potencia|p)
    set_model "openrouter/anthropic/claude-opus-4-8"
    ;;
  codigo|c)
    set_model "opencode/nemotron-3-ultra-free"
    ;;
  rapido|r)
    set_model "opencode/deepseek-v4-flash-free"
    ;;
  barato|b)
    set_model "opencode/mimo-v2.5-free"
    ;;
  smart|sm)
    set_model "openrouter/anthropic/claude-haiku-4-5"
    ;;
  restore|back)
    if [ -f "$LAST_MODEL_FILE" ]; then
      last=$(cat "$LAST_MODEL_FILE")
      set_model "$last"
    else
      echo "No previous model to restore."
    fi
    ;;
  switch|sw)
    shift
    ~/.local/bin/nexo-model-switch "$*" --apply
    ;;
  log|l)
    show_log
    ;;
  *)
    echo "Usage: nexo-model <command>"
    echo "Commands: status, default, potencia, codigo, rapido, barato, smart, restore, switch \"msg\", log"
    ;;
esac
